<view class="savings-page {{tab === 0 ? 'ledger-page' : ''}} {{themeClass}}">
  <view class="heading"><view><view class="eyebrow">一起积累</view><view class="title">共同储蓄</view></view><picker mode="date" fields="month" value="{{year}}-{{month < 10 ? '0' : ''}}{{month}}-01" start="2020-01-01" end="2100-12-31" bindchange="changePeriod"><view class="year">{{year}} / {{month}} ⌄</view></picker></view>
  <view class="hint">{{scopeLabel}}</view>
  <view class="tabs"><button class="{{tab === 0 ? 'selected' : ''}}" data-tab="0" bindtap="changeTab">日常记账</button><button class="{{tab === 1 ? 'selected' : ''}}" data-tab="1" bindtap="changeTab">年度测算</button></view>
  <view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view>
  <view class="hint" wx:if="{{loading}}">正在同步…</view>
  <block wx:if="{{tab === 0}}">
    <view class="member-tabs"><button class="{{entryType === 'expense' ? 'selected' : ''}}" data-type="expense" bindtap="selectEntryType">支出</button><button class="{{entryType === 'income' ? 'selected' : ''}}" data-type="income" bindtap="selectEntryType">收入</button></view>
    <view class="ledger-summary"><text>{{month}} 月{{entryType === 'expense' ? '支出' : '收入'}}</text><text>¥ {{ledgerTotalText || '0.00'}}</text></view>
    <view class="ledger-list">
      <view class="empty" wx:if="{{!entries.length && !loading}}">本月还没有{{entryType === 'expense' ? '支出' : '收入'}}记录。点下方 ＋，记下第一笔</view>
      <view class="date-group" wx:for="{{entryGroups}}" wx:for-item="group" wx:key="date">
        <view class="date-heading">{{group.title}}</view>
        <view class="date-entries">
          <view class="entry-compact" wx:for="{{group.entries}}" wx:key="_id" data-id="{{item._id}}" bindtap="openExistingEntry" aria-role="button" aria-label="编辑{{item.category}}{{item.subcategory}}，{{item.amountText}}元">
            <view class="entry-label">{{item.category}}{{item.subcategory ? ' - ' + item.subcategory : ''}} - {{item.recorderName}}</view>
            <view class="entry-amount {{item.type === 'income' ? 'income' : ''}}">{{item.type === 'income' ? '+' : '−'}}{{item.amountText}}</view>
            <button class="entry-delete" disabled="{{busy}}" data-id="{{item._id}}" catchtap="removeEntry" aria-label="删除此记录">删除</button>
          </view>
        </view>
      </view>
      <button wx:if="{{cursor}}" class="secondary" bindtap="more">加载更多</button>
    </view>
    <view class="ledger-actions"><view class="action-spacer"/><button class="add-entry" bindtap="openEntry" disabled="{{busy || loading || !overview}}" aria-label="新增{{entryType === 'income' ? '收入' : '支出'}}">＋</button><button class="statistics-entry" data-page="statistics" bindtap="goEditor">统计 ↗</button></view>
  </block>
  <block wx:else>
    <view class="hint" wx:if="{{!overview.plan}}">先设置双方收入与支出预算，建立储蓄目标。</view>
    <view class="error" wx:if="{{calcError}}">{{calcError}}</view>
    <block wx:if="{{result}}">
      <view class="section"><view class="section-head">{{year}} 年收入</view><view class="hero-value">¥ {{result.netText}}</view><view class="hint">预计全年税后收入 · 含年终奖</view><view class="metric"><view class="row"><text>已记收入 ¥ {{annualIncome}}</text><text>{{progressRows[3].percent}}</text></view><view class="track"><view class="fill" style="width:{{progressRows[3].width}}%"/></view></view><view class="hint">税前 {{result.grossText}} 元 · 公积金 {{result.housingText}} 元</view>
        <view class="divider"/><view class="section-head">{{month}} 月收入</view><view class="hero-value small">¥ {{result.monthlyNetText}}</view><view class="hint">按月薪估算的月均税后收入，不含年终奖</view><view class="metric"><view class="row"><text>已记收入 ¥ {{monthlyIncome}}</text><text>{{progressRows[0].percent}}</text></view><view class="track"><view class="fill" style="width:{{progressRows[0].width}}%"/></view></view><button class="secondary settings-entry" data-page="income" bindtap="goEditor">修改双方收入 →</button></view>
      <view class="section"><view class="section-head">支出预算</view><view class="metric"><view class="row"><text>全年支出</text><text>{{progressRows[4].percent}}</text></view><view class="numbers">{{annualExpense}} <text>/ {{result.budgetText}} 元</text></view><view class="track"><view class="fill" style="width:{{progressRows[4].width}}%"/></view></view><view class="metric"><view class="row"><text>{{month}} 月支出</text><text>{{progressRows[1].percent}}</text></view><view class="numbers">{{monthlyExpense}} <text>/ {{progressRows[1].target}} 元</text></view><view class="track"><view class="fill" style="width:{{progressRows[1].width}}%"/></view></view><button class="secondary settings-entry" data-page="budget" bindtap="goEditor">修改支出预算 →</button></view>
      <view class="section"><view class="section-head">全年现金储蓄目标</view><view class="hero-value">¥ {{result.targetText}}</view><view class="hint">已记结余 {{annualBalance}} 元 · {{progressRows[5].percent}}</view><view class="track"><view class="fill" style="width:{{progressRows[5].width}}%"/></view><view class="error" wx:if="{{result.target < 0}}">预算超过收入，请调整支出。</view></view>
    </block>
    <view class="row" wx:if="{{!result}}"><button class="secondary" data-page="income" bindtap="goEditor">修改收入</button><button class="secondary" data-page="budget" bindtap="goEditor">修改预算</button></view>
    <view class="hint footnote">月收入按工资本身的全年个税平均估算，不含奖金及奖金相关税款；实际各月预扣税可能不同。实际收入按记账金额统计，奖金到账也会计入实际收入。年度支出预算按12个月均摊；公积金单独展示，不计入可支出现金。</view>
  </block>
  <view class="mask" wx:if="{{entryOpen}}" catchtap="closeEntry">
    <view class="sheet entry-sheet" catchtap="noop">
      <view class="sheet-handle"/>
      <view class="section-head"><text>{{editingEntry ? '修改' : '记一笔'}}{{entry.type === 'income' ? '收入' : '支出'}}</text><button class="text-button entry-confirm" disabled="{{busy}}" loading="{{busy}}" bindtap="saveEntry">确定</button></view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="error" wx:if="{{entryError}}">{{entryError}}</view>
        <view class="entry-form-row">
          <view class="field"><text>金额（元）</text><input type="digit" value="{{entry.amount}}" data-key="amount" bindinput="editEntry" disabled="{{busy}}" placeholder="0.00"/></view>
          <view class="field"><text>日期</text><picker mode="date" start="{{entryStart}}" end="{{entryEnd}}" disabled="{{busy}}" value="{{entry.date}}" data-key="date" bindchange="editEntry"><view class="input">{{entry.date}} ⌄</view></picker></view>
        </view>
        <view class="field"><text>大类</text><picker range="{{categories}}" disabled="{{busy}}" data-key="category" bindchange="editEntry"><view class="input">{{entry.category}} ⌄</view></picker></view>
        <view class="field"><text>小类</text><input value="{{entry.subcategory}}" data-key="subcategory" bindinput="editEntry" disabled="{{busy}}" maxlength="30" placeholder="输入小类"/></view>
        <view class="history-options" wx:if="{{subcategorySuggestions.length}}"><button wx:for="{{subcategorySuggestions}}" wx:key="*this" disabled="{{busy}}" data-value="{{item}}" bindtap="chooseSubcategory">{{item}}</button></view>
        <view class="field"><text>备注（选填）</text><input value="{{entry.note}}" maxlength="100" data-key="note" bindinput="editEntry" disabled="{{busy}}"/></view>
      </scroll-view>
    </view>
  </view>
</view>
