.savings-page{min-height:100vh;background:var(--love-bg);color:var(--love-text);padding:36rpx var(--love-page-gutter) calc(var(--love-tab-height) + env(safe-area-inset-bottom) + 40rpx)}
.heading,.row,.section-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.heading{align-items:flex-start;flex-wrap:wrap}.eyebrow{color:var(--love-primary);font-size:22rpx;letter-spacing:3rpx}.title{font-family:var(--love-heading-font);font-size:44rpx;line-height:1.4;margin:12rpx 0}.year{padding:16rpx;background:var(--love-surface);border-radius:var(--love-radius-control);font-size:26rpx}.hint{font-size:24rpx;line-height:1.7;color:var(--love-text-secondary);margin:12rpx 0;word-break:break-all}.tabs{display:flex;margin:28rpx 0;padding:6rpx;background:var(--love-surface-muted);border-radius:var(--love-radius-control)}button{margin:0;font-size:28rpx;line-height:1.5;padding:20rpx;border-radius:var(--love-radius-control);min-height:84rpx}button::after{border:0}.tabs button{flex:1;background:transparent;color:var(--love-text-secondary)}.tabs .selected{background:var(--love-surface);color:var(--love-primary);font-weight:600}.section{padding:28rpx;margin:24rpx 0;background:var(--love-surface);border:1rpx solid var(--love-border);border-radius:var(--love-radius-card)}.section-head{font-size:30rpx;font-weight:600;margin-bottom:16rpx}.metric{margin-top:26rpx}.metric .row{font-size:25rpx}.numbers{font-size:32rpx;margin:10rpx 0;word-break:break-all}.numbers text{font-size:24rpx;color:var(--love-text-muted)}.track{height:8rpx;background:var(--love-surface-muted);border-radius:8rpx;overflow:hidden}.fill{height:100%;background:var(--love-primary)}.primary{background:var(--love-primary);color:var(--love-on-primary);width:100%}.secondary{background:var(--love-soft);color:var(--love-primary);width:100%}.primary[disabled]{opacity:.5}.entry{display:flex;gap:16rpx;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid var(--love-border);font-size:28rpx}.entry-main{flex:1;min-width:0;word-break:break-all}.income{color:var(--love-success)}.text-button{background:transparent;color:var(--love-primary);font-size:24rpx;padding:14rpx 8rpx;min-height:72rpx}.empty{padding:36rpx 0;color:var(--love-text-muted);font-size:26rpx}.person-toggle{display:flex;justify-content:space-between;width:100%;color:var(--love-primary);background:var(--love-soft);margin:20rpx 0}.person-toggle text{font-size:24rpx}.field{margin:24rpx 0;font-size:25rpx}.field>view:first-child{margin-bottom:12rpx}input,.input{height:88rpx;background:var(--love-surface-muted);border:1rpx solid var(--love-border);border-radius:var(--love-radius-control);padding:0 20rpx;font-size:28rpx;line-height:88rpx;color:var(--love-text);width:100%;box-sizing:border-box}.budget{border-bottom:1rpx solid var(--love-border);padding:20rpx 0;margin-bottom:20rpx}.budget .row{margin-top:12rpx;flex-wrap:wrap}.budget .row input{flex:1;min-width:160rpx}.error{padding:20rpx;background:var(--love-warning-soft);color:var(--love-warning);border-radius:var(--love-radius-control);font-size:25rpx;margin:20rpx 0}.result-grid{display:flex;flex-wrap:wrap;gap:24rpx}.result-grid>view{flex:1 1 42%;font-size:24rpx;color:var(--love-text-secondary)}.result-grid text{display:block;color:var(--love-text);font-size:30rpx;font-weight:600;word-break:break-all;margin-top:10rpx}.target{background:var(--love-primary);color:var(--love-on-primary);padding:28rpx;border-radius:var(--love-radius-card);margin:28rpx 0;font-size:26rpx}.target text{display:block;font-size:42rpx;word-break:break-all;margin-top:12rpx}.person-result{padding-top:22rpx;border-top:1rpx solid var(--love-border);margin-top:22rpx;font-size:28rpx}.footnote{padding:12rpx}.mask{position:fixed;inset:0;background:var(--love-overlay);z-index:1000;display:flex;align-items:flex-end}.sheet{background:var(--love-surface);border-radius:var(--love-radius-card) var(--love-radius-card) 0 0;width:100%;padding:28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom))}.sheet-scroll{height:75vh}
.member-tabs { display:flex; gap:8rpx; padding:6rpx; margin:24rpx 0; background:var(--love-surface-muted); border-radius:var(--love-radius-control); }
.member-tabs button { flex:1; min-width:0; background:transparent; color:var(--love-text-secondary); }
.member-tabs .selected { background:var(--love-surface); color:var(--love-primary); font-weight:600; }
.member-confirm { margin-top:28rpx; }
.ledger-page{padding-bottom:calc(var(--love-tab-height) + env(safe-area-inset-bottom) + 180rpx)}
.ledger-summary{display:flex;align-items:center;justify-content:space-between;margin:28rpx 0;font-size:26rpx;color:var(--love-text-secondary)}
.ledger-summary>text:last-child{font-size:38rpx;font-weight:600;color:var(--love-text)}
.ledger-list{margin-top:16rpx;min-height:240rpx}
.ledger-actions{position:fixed;bottom:calc(var(--love-tab-height) + env(safe-area-inset-bottom));left:0;right:0;display:flex;align-items:center;justify-content:center;padding:16rpx 32rpx;background:var(--love-bg);border-top:1rpx solid var(--love-border);z-index:800;gap:28rpx}
.add-entry{width:104rpx;height:104rpx;border-radius:50%;background:var(--love-primary);color:var(--love-on-primary);font-size:52rpx;line-height:1;padding:0;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.statistics-entry,.action-spacer{width:140rpx;flex-shrink:0}.statistics-entry{background:transparent;color:var(--love-primary);font-size:26rpx;padding:12rpx}
.hero-value{font-family:var(--love-heading-font);font-size:46rpx;font-weight:600;word-break:break-all}.hero-value.small{font-size:38rpx}
.divider{height:1rpx;background:var(--love-border);margin:30rpx 0}
.settings-entry{margin-top:28rpx}.settings-page{padding-bottom:calc(env(safe-area-inset-bottom) + 48rpx)}
.member-tabs button{white-space:normal;word-break:break-all}
.metric .row{flex-wrap:wrap;align-items:flex-start}
.metric .row text{min-width:0;word-break:break-all}
.ledger-summary>text:last-child{min-width:0;word-break:break-all;text-align:right}
.date-group{margin:24rpx 0}
.date-heading{font-size:24rpx;color:var(--love-text-secondary);padding:8rpx 4rpx 14rpx;font-weight:500}
.date-entries{background:var(--love-surface);border:1rpx solid var(--love-border);border-radius:var(--love-radius-card);overflow:hidden}
.entry-compact{display:flex;align-items:center;gap:12rpx;min-height:88rpx;padding:6rpx 14rpx 6rpx 20rpx;border-bottom:1rpx solid var(--love-border)}
.entry-compact:last-child{border-bottom:0}
.entry-label{flex:1;min-width:0;font-size:25rpx;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.entry-amount{font-size:27rpx;font-weight:600;max-width:220rpx;word-break:break-all;text-align:right}
.entry-delete{flex-shrink:0;color:var(--love-danger);background:transparent;min-height:76rpx;padding:14rpx 8rpx;font-size:23rpx}
.entry-sheet{max-height:80vh;display:flex;flex-direction:column}
.entry-sheet .section-head{margin-bottom:4rpx;flex-shrink:0}
.sheet-handle{height:6rpx;width:54rpx;background:var(--love-border);border-radius:6rpx;margin:0 auto 8rpx;flex-shrink:0}
.entry-sheet .sheet-scroll{height:46vh;min-height:0;flex-shrink:1}
.entry-form-row{display:flex;gap:18rpx}
.entry-form-row>.field{flex:1;min-width:0}
.entry-sheet .field{margin:14rpx 0}
.entry-sheet input,.entry-sheet .input{height:76rpx;line-height:76rpx;font-size:26rpx;margin-top:8rpx}
.history-options{display:flex;flex-wrap:wrap;gap:12rpx;margin:14rpx 0}
.history-options button{min-height:60rpx;background:var(--love-soft);color:var(--love-primary);font-size:23rpx;line-height:1.4;padding:14rpx 18rpx;max-width:100%;word-break:break-all}
.entry-confirm{font-weight:600;min-width:104rpx}
