.location-page {
  background: var(--love-bg);
  color: var(--love-text);
  min-height: 100vh;
  padding: 40rpx var(--love-page-gutter) calc(var(--love-tab-height) + env(safe-area-inset-bottom) + 40rpx);
}
.location-heading { align-items: flex-start; display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: space-between; margin-bottom: 32rpx; }
.location-heading-copy { flex: 1; min-width: 300rpx; }
.location-eyebrow { color: var(--love-primary); font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; }
.location-title { font-family: var(--love-heading-font); font-size: 48rpx; font-weight: 600; letter-spacing: 1rpx; line-height: 1.3; margin-top: 10rpx; }
.location-subtitle { color: var(--love-text-secondary); font-size: 24rpx; margin-top: 14rpx; }
.sharing-badge { align-items: center; border: 1rpx solid var(--love-border); border-radius: var(--love-radius-control); color: var(--love-text-secondary); display: flex; font-size: 22rpx; margin-top: 8rpx; padding: 10rpx 14rpx; }
.sharing-badge-active { background: var(--love-soft); border-color: var(--love-soft); color: var(--love-primary); }
.sharing-dot, .map-caption-dot { background: currentColor; border-radius: 50%; flex: 0 0 8rpx; height: 8rpx; margin-right: 12rpx; width: 8rpx; }
.connection-banner, .error-message { background: var(--love-warning-soft); border-radius: var(--love-radius-control); color: var(--love-warning); font-size: 24rpx; line-height: 1.6; padding: 20rpx 24rpx; }
.connection-banner { margin-bottom: 24rpx; }
.map-card { background: var(--love-surface); border: 1rpx solid var(--love-border); border-radius: var(--love-radius-card); overflow: hidden; }
.couple-map, .map-empty { height: 600rpx; width: 100%; }
.map-empty { align-items: center; background: var(--love-surface-muted); display: flex; flex-direction: column; justify-content: center; padding: 40rpx; text-align: center; }
.map-empty-symbol { border: 3rpx solid var(--love-primary); border-radius: 50% 50% 50% 0; height: 56rpx; margin-bottom: 40rpx; position: relative; transform: rotate(-45deg); width: 56rpx; }
.map-empty-symbol::after { border: 3rpx solid var(--love-primary); border-radius: 50%; content: ''; height: 16rpx; left: 16rpx; position: absolute; top: 16rpx; width: 16rpx; }
.map-empty-title { color: var(--love-text); font-family: var(--love-heading-font); font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.map-empty-text { color: var(--love-text-secondary); font-size: 24rpx; line-height: 1.85; margin-top: 18rpx; white-space: pre-line; }
.map-caption { align-items: center; color: var(--love-text-secondary); display: flex; font-size: 22rpx; line-height: 1.5; min-height: 76rpx; padding: 18rpx 24rpx; }
.map-caption-dot { color: var(--love-primary); }
.map-controls { background: var(--love-surface-muted); border-radius: var(--love-radius-control); display: flex; gap: 6rpx; margin: 24rpx 0 32rpx; padding: 6rpx; }
button::after { border: 0; }
.map-control { align-items: center; background: transparent; border-radius: var(--love-radius-control); color: var(--love-text-secondary); display: flex; flex: 1; font-size: 24rpx; font-weight: 500; justify-content: center; line-height: 1.3; margin: 0; min-height: 80rpx; min-width: 0; padding: 12rpx 4rpx; }
.map-control-active { background: var(--love-surface); color: var(--love-primary-dark); font-weight: 600; }
.map-control[disabled] { background: transparent; color: var(--love-text-muted); opacity: 0.55; }
.people-card { border-bottom: 1rpx solid var(--love-border); border-top: 1rpx solid var(--love-border); padding: 0 4rpx; }
.person-row { align-items: center; display: flex; padding: 28rpx 0; }
.person-icon { align-items: center; border: 1rpx solid var(--love-border); border-radius: var(--love-radius-control); display: flex; flex: 0 0 76rpx; font-size: 26rpx; font-weight: 600; height: 76rpx; justify-content: center; }
.person-icon-partner { background: var(--love-soft); border-color: var(--love-soft); color: var(--love-primary); }
.person-icon-self { background: var(--love-surface); color: var(--love-text-secondary); }
.person-copy { flex: 1; min-width: 0; padding: 0 20rpx; }
.person-name { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.person-update { color: var(--love-text-secondary); font-size: 22rpx; line-height: 1.6; margin-top: 8rpx; }
.person-update-stale { color: var(--love-warning); }
.person-state { color: var(--love-text-muted); flex: 0 0 90rpx; font-size: 22rpx; text-align: right; }
.person-state-fresh { color: var(--love-primary); }
.person-divider { background: var(--love-border); height: 1rpx; margin-left: 96rpx; }
.sharing-card { margin-top: 40rpx; }
.sharing-title { font-family: var(--love-heading-font); font-size: 32rpx; font-weight: 600; }
.sharing-description { color: var(--love-text-secondary); font-size: 26rpx; line-height: 1.8; margin-top: 18rpx; }
.sharing-footnote { color: var(--love-text-muted); font-size: 22rpx; line-height: 1.7; margin-top: 16rpx; }
.error-message { margin-top: 20rpx; }
.sharing-action { margin: 24rpx 0 0; }
.button-primary, .button-secondary { align-items: center; border-radius: var(--love-radius-control); display: flex; font-size: 28rpx; font-weight: 600; justify-content: center; line-height: 1.5; min-height: 88rpx; padding: 20rpx 24rpx; }
.button-primary { background: var(--love-primary); color: var(--love-on-primary); }
.button-secondary { background: var(--love-surface); border: 1rpx solid var(--love-border); color: var(--love-text); }
.button-primary[disabled], .button-secondary[disabled] { opacity: 0.55; }
.bind-button { margin-top: 28rpx; min-width: 280rpx; }
.settings-button { background: transparent; color: var(--love-primary-dark); font-size: 26rpx; line-height: 1.5; margin: 8rpx 0 0; min-height: 80rpx; padding: 20rpx 0; text-align: left; }
.standalone-error { margin-top: 24rpx; }
.privacy-card { background: var(--love-surface); border: 1rpx solid var(--love-border); border-radius: var(--love-radius-card); padding: 28rpx; }
.privacy-title { color: var(--love-text); font-size: 30rpx; font-weight: 600; }
.privacy-description { color: var(--love-text-secondary); font-size: 26rpx; line-height: 1.8; margin-top: 16rpx; }
.privacy-link { background: transparent; color: var(--love-primary-dark); font-size: 24rpx; line-height: 1.5; margin: 12rpx 0; min-height: 80rpx; padding: 20rpx 0; text-align: left; }
.privacy-card-top { margin: 0 0 24rpx; }
.permission-card { border-left: 3rpx solid var(--love-primary); margin-bottom: 24rpx; padding: 0 0 0 24rpx; }
