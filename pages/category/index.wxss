page {
  background: #f4f5f5;
  color: #292421;
  height: 100%;
  overflow: hidden;
}

.menu-page {
  background: var(--love-bg, #f4f5f5);
  box-sizing: border-box;
  height: calc(100vh - env(safe-area-inset-bottom) - 108rpx);
  overflow: hidden;
  padding-top: 24rpx;
}

.menu-heading {
  align-items: center;
  display: flex;
  justify-content: space-between;
  padding: 10rpx 30rpx 30rpx;
}

.menu-eyebrow {
  color: var(--love-primary, #bd7180);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.menu-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 46rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.wish-button {
  align-items: center;
  background: #292421;
  border-radius: 50%;
  color: #fff;
  display: flex;
  font-size: 38rpx;
  height: 76rpx;
  justify-content: center;
  position: relative;
  width: 76rpx;
}

.wish-count {
  align-items: center;
  background: var(--love-primary, #d77f8d);
  border: 3rpx solid #f8f5f2;
  border-radius: 50%;
  display: flex;
  font-size: 17rpx;
  height: 31rpx;
  justify-content: center;
  position: absolute;
  right: -5rpx;
  top: -5rpx;
  width: 31rpx;
}

.menu-body {
  display: flex;
  height: calc(100% - 126rpx);
}

.shared-empty {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 65vh;
  padding: 0 70rpx;
  text-align: center;
}

.shared-empty-icon {
  color: var(--love-primary, #bd7180);
  font-size: 76rpx;
}

.shared-empty-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 22rpx;
}

.shared-empty-note {
  color: #a69c96;
  font-size: 21rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.shared-empty-button {
  background: #292421;
  border-radius: 999rpx;
  color: #fff;
  font-size: 23rpx;
  margin-top: 30rpx;
  padding: 19rpx 38rpx;
}

.category-side {
  box-sizing: border-box;
  flex: 0 0 166rpx;
  height: 100%;
  padding: 12rpx 16rpx 30rpx;
}

.side-item {
  align-items: center;
  border-radius: 24rpx;
  color: #9e948f;
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 8rpx;
  position: relative;
}

.side-item-active {
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(76, 58, 51, 0.07);
  color: #292421;
  font-weight: 600;
}

.side-item-active::before {
  background: var(--love-primary, #c87280);
  border-radius: 0 5rpx 5rpx 0;
  content: '';
  height: 42rpx;
  left: -16rpx;
  position: absolute;
  top: 38rpx;
  width: 6rpx;
}

.side-icon {
  font-size: 35rpx;
}

.menu-list {
  box-sizing: border-box;
  height: 100%;
  padding: 10rpx 28rpx 24rpx 8rpx;
}

.active-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 600;
  margin: 0 0 24rpx 6rpx;
}

.active-title text {
  color: #a79c96;
  display: block;
  font-family: sans-serif;
  font-size: 19rpx;
  font-weight: 400;
  margin-top: 5rpx;
}

.dish-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 35rpx rgba(77, 58, 52, 0.06);
  display: flex;
  height: 160rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
}

.dish-image {
  border-radius: 28rpx;
  display: block;
  flex: 0 0 160rpx;
  height: 100%;
  width: 160rpx;
}

.dish-info {
  box-sizing: border-box;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 10rpx 16rpx;
}

.dish-badge {
  background: var(--love-soft, #f7e9eb);
  border-radius: 14rpx;
  color: var(--love-primary, #ba6875);
  display: inline-block;
  font-size: 14rpx;
  margin-bottom: 3rpx;
  padding: 2rpx 8rpx;
  width: fit-content;
}

.dish-name {
  font-size: 23rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-description {
  color: #9e958f;
  display: -webkit-box;
  font-size: 16rpx;
  line-height: 1.35;
  margin-top: 3rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.dish-bottom {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: auto;
}

.dish-price {
  color: var(--love-primary, #b75f6d);
  flex: 1;
  font-size: 18rpx;
  font-weight: 600;
  min-width: 0;
  overflow: hidden;
  padding-right: 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-price text {
  color: #a79c96;
  font-size: 18rpx;
  font-weight: 400;
}

.dish-add {
  align-items: center;
  background: #292421;
  border-radius: 50%;
  color: #fff;
  display: flex;
  flex: 0 0 40rpx;
  font-size: 24rpx;
  height: 40rpx;
  justify-content: center;
  width: 40rpx;
}

.menu-list-end {
  color: #b4aaa5;
  font-size: 19rpx;
  padding: 32rpx 0 20rpx;
  text-align: center;
}
