page {
  height: 100%;
  overflow: hidden;
}

.menu-page {
  background: var(--love-bg);
  box-sizing: border-box;
  color: var(--love-text);
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding: 36rpx 0 calc(var(--love-tab-height) + env(safe-area-inset-bottom) + 16rpx);
}

.menu-heading {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  gap: 24rpx;
  justify-content: space-between;
  padding: 0 var(--love-page-gutter) 28rpx;
}

.menu-eyebrow {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  line-height: 1.5;
}

.menu-title {
  font-family: var(--love-heading-font);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.35;
  margin-top: 10rpx;
}

.wish-button {
  align-items: center;
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-primary);
  display: flex;
  flex-shrink: 0;
  font-size: 38rpx;
  height: 84rpx;
  justify-content: center;
  position: relative;
  width: 84rpx;
}

.wish-count {
  align-items: center;
  background: var(--love-primary);
  border: 3rpx solid var(--love-bg);
  border-radius: 24rpx;
  box-sizing: border-box;
  color: var(--love-on-primary);
  display: flex;
  font-size: 22rpx;
  height: 40rpx;
  justify-content: center;
  min-width: 40rpx;
  padding: 0 6rpx;
  position: absolute;
  right: -12rpx;
  top: -12rpx;
}

.menu-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

.shared-empty {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-height: 0;
  padding: 32rpx 60rpx 64rpx;
  text-align: center;
}

.shared-empty-icon {
  align-items: center;
  background: var(--love-soft);
  border-radius: var(--love-radius-card);
  color: var(--love-primary);
  display: flex;
  font-size: 72rpx;
  height: 144rpx;
  justify-content: center;
  width: 144rpx;
}

.shared-empty-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 28rpx;
}

.shared-empty-note {
  color: var(--love-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
  margin-top: 12rpx;
}

.shared-empty-button {
  align-items: center;
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-on-primary);
  display: flex;
  font-size: 28rpx;
  justify-content: center;
  margin-top: 32rpx;
  min-height: 88rpx;
  padding: 16rpx 36rpx;
}

.category-tabs {
  border-bottom: 1rpx solid var(--love-border);
  box-sizing: border-box;
  flex-shrink: 0;
  width: 100%;
}

.category-tab-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
  padding: 0 var(--love-page-gutter) 24rpx;
}

.side-item {
  align-items: center;
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text-secondary);
  display: flex;
  flex-shrink: 0;
  font-size: 26rpx;
  gap: 12rpx;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 22rpx;
}

.side-item-active {
  background: var(--love-primary);
  border-color: var(--love-primary);
  color: var(--love-on-primary);
  font-weight: 600;
}

.side-icon {
  align-items: center;
  border-radius: 8rpx;
  display: flex;
  flex-shrink: 0;
  font-size: 26rpx;
  height: 44rpx;
  justify-content: center;
  overflow: hidden;
  width: 44rpx;
}

.side-icon-image {
  display: block;
}

.side-name {
  max-width: 300rpx;
  white-space: normal;
  word-break: break-all;
}

.menu-list {
  box-sizing: border-box;
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 28rpx var(--love-page-gutter) 0;
}

.active-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 24rpx;
  word-break: break-all;
}

.active-title text {
  color: var(--love-text-secondary);
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 23rpx;
  font-weight: 400;
  margin-top: 6rpx;
}

.dish-card {
  align-items: flex-start;
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  display: flex;
  gap: 24rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  padding: 24rpx;
}

.dish-image {
  border-radius: var(--love-radius-control);
  display: block;
  flex: 0 0 168rpx;
  height: 188rpx;
  width: 168rpx;
}

.dish-image.letter-avatar {
  display: flex;
  font-size: 54rpx;
}

.dish-info {
  box-sizing: border-box;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.dish-badge {
  align-self: flex-start;
  background: var(--love-soft);
  border-radius: 8rpx;
  color: var(--love-primary);
  font-size: 22rpx;
  line-height: 1.4;
  margin-bottom: 10rpx;
  padding: 6rpx 10rpx;
  word-break: break-all;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.dish-description {
  color: var(--love-text-secondary);
  display: -webkit-box;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dish-bottom {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-top: 16rpx;
}

.dish-price {
  color: var(--love-primary);
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  min-width: 0;
  word-break: break-all;
}

.dish-add {
  align-items: center;
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  display: flex;
  flex: 0 0 80rpx;
  font-size: 32rpx;
  height: 80rpx;
  justify-content: center;
  width: 80rpx;
}

.menu-list-end {
  color: var(--love-text-muted);
  font-size: 22rpx;
  line-height: 1.5;
  padding: 24rpx 0 32rpx;
  text-align: center;
}
