page {
  min-height: 100%;
}

.wish-page {
  background: var(--love-bg);
  box-sizing: border-box;
  color: var(--love-text);
  min-height: 100vh;
  padding: 36rpx var(--love-page-gutter) calc(env(safe-area-inset-bottom) + 208rpx);
}

.wish-heading {
  padding-bottom: 36rpx;
}

.wish-eyebrow {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  line-height: 1.5;
}

.wish-title {
  font-family: var(--love-heading-font);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.35;
  margin-top: 10rpx;
}

.wish-subtitle {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.wish-card {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  margin-bottom: 20rpx;
  overflow: hidden;
  padding: 24rpx;
}

.wish-card-content {
  align-items: flex-start;
  display: flex;
  gap: 24rpx;
}

.wish-image {
  border-radius: var(--love-radius-control);
  flex: 0 0 152rpx;
  height: 152rpx;
  width: 152rpx;
}

.wish-image.letter-avatar {
  display: flex;
  font-size: 52rpx;
}

.wish-info {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.wish-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.wish-description {
  color: var(--love-text-secondary);
  display: -webkit-box;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 10rpx;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.wish-bottom {
  align-items: center;
  border-top: 1rpx solid var(--love-border);
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 18rpx;
}

.wish-price {
  color: var(--love-primary);
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  min-width: 0;
  word-break: break-all;
}

.stepper {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  gap: 6rpx;
}

.step-button {
  align-items: center;
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text);
  display: flex;
  font-size: 30rpx;
  height: 80rpx;
  justify-content: center;
  width: 80rpx;
}

.step-button-dark {
  background: var(--love-primary);
  border-color: var(--love-primary);
  color: var(--love-on-primary);
}

.step-value {
  font-size: 26rpx;
  font-weight: 500;
  min-width: 48rpx;
  text-align: center;
}

.note-card {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  margin-top: 28rpx;
  padding: 28rpx;
}

.note-title {
  font-family: var(--love-heading-font);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.note-input {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text);
  font-size: 26rpx;
  height: 188rpx;
  line-height: 1.65;
  margin-top: 20rpx;
  padding: 22rpx;
  width: 100%;
}

.note-placeholder {
  color: var(--love-text-muted);
}

.note-count {
  color: var(--love-text-muted);
  font-size: 22rpx;
  margin-top: 12rpx;
  text-align: right;
}

.submit-bar {
  align-items: center;
  background: var(--love-surface);
  border-top: 1rpx solid var(--love-border);
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  left: 0;
  padding: 24rpx var(--love-page-gutter) calc(env(safe-area-inset-bottom) + 24rpx);
  position: fixed;
  right: 0;
  z-index: 10;
}

.submit-summary {
  flex: 1;
  min-width: 0;
}

.submit-label {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.submit-price {
  color: var(--love-text);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-top: 2rpx;
  word-break: break-all;
}

.submit-button {
  align-items: center;
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-on-primary);
  display: flex;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  justify-content: center;
  min-height: 96rpx;
  padding: 20rpx 44rpx;
}

.submit-button-disabled {
  opacity: 0.55;
}

.empty-state {
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 96rpx 20rpx 40rpx;
  text-align: center;
}

.empty-heart {
  align-items: center;
  background: var(--love-soft);
  border-radius: var(--love-radius-card);
  color: var(--love-primary);
  display: flex;
  font-size: 76rpx;
  height: 160rpx;
  justify-content: center;
  width: 160rpx;
}

.empty-title {
  font-family: var(--love-heading-font);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 32rpx;
}

.empty-description {
  color: var(--love-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
  margin-top: 12rpx;
}

.empty-button {
  align-items: center;
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  display: flex;
  font-size: 28rpx;
  justify-content: center;
  margin-top: 36rpx;
  min-height: 88rpx;
  padding: 0 48rpx;
}
