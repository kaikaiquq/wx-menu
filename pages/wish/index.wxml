<view class="wish-page {{themeClass}}">
  <view class="wish-heading">
    <view class="wish-eyebrow">一起期待</view>
    <view class="wish-title">这次想要的</view>
    <view class="wish-subtitle">一共 {{totalCount}} 份小期待</view>
  </view>

  <block wx:if="{{wishItems.length}}">
    <view class="wish-list">
      <view class="wish-card" wx:for="{{wishItems}}" wx:key="id">
        <view class="wish-card-content">
          <image class="wish-image" wx:if="{{item.hasImage}}" src="{{item.image}}" mode="aspectFill" />
          <view
            class="wish-image letter-avatar"
            wx:else
            style="background: {{item.avatarColor}};"
          >{{item.avatarText}}</view>
          <view class="wish-info">
            <view class="wish-name">{{item.name}}</view>
            <view class="wish-description">{{item.description}}</view>
          </view>
        </view>
        <view class="wish-bottom">
          <view class="wish-price">{{item.cost}}</view>
          <view class="stepper">
            <view class="step-button" aria-role="button" aria-label="减少{{item.name}}的数量" data-id="{{item.id}}" data-step="-1" bind:tap="changeQuantity">−</view>
            <view class="step-value">{{item.quantity}}</view>
            <view class="step-button step-button-dark" aria-role="button" aria-label="增加{{item.name}}的数量" data-id="{{item.id}}" data-step="1" bind:tap="changeQuantity">＋</view>
          </view>
        </view>
      </view>
    </view>

    <view class="note-card">
      <view class="note-title">留句话给 TA</view>
      <textarea
        class="note-input"
        value="{{note}}"
        maxlength="80"
        placeholder="比如：周五晚上，想和你一起吃"
        placeholder-class="note-placeholder"
        bindinput="updateNote"
      />
      <view class="note-count">{{note.length}} / 80</view>
    </view>

    <view class="submit-bar">
      <view class="submit-summary">
        <view class="submit-label">本次心愿</view>
        <view class="submit-price">{{totalCount}} 项</view>
      </view>
      <view class="submit-button {{submitting ? 'submit-button-disabled' : ''}}" aria-role="button" aria-label="发送心愿单" bind:tap="submitOrder">
        {{submitting ? '正在送出...' : '发给 TA 看'}}
      </view>
    </view>
  </block>

  <view class="empty-state" wx:else>
    <view class="empty-heart">♡</view>
    <view class="empty-title">心愿单还是空的</view>
    <view class="empty-description">去选一点想和 TA 一起做的事吧</view>
    <view class="empty-button" bind:tap="goMenu">开始点单</view>
  </view>
</view>
