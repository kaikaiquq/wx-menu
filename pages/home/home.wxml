<view class="home-page {{themeClass}}">
  <view class="page-loading" wx:if="{{loading}}">正在同步你们的菜单...</view>
  <view class="home-header">
    <view class="header-copy">
      <view class="eyebrow">{{dateText}}</view>
      <view class="greeting-row">
        <view class="greeting">今天想和你做什么？</view>
        <view class="wish-alert" wx:if="{{showWishAlert}}" catch:tap="openResponseAlert">!</view>
      </view>
    </view>
    <view class="wish-pill" bind:tap="openWish">
      <text class="wish-icon">♡</text>
      <text wx:if="{{wishCount}}">{{wishCount}}</text>
    </view>
  </view>

  <view class="hero-card" bind:tap="editSharedMessage">
    <view class="hero-orbit orbit-one"></view>
    <view class="hero-orbit orbit-two"></view>
    <view class="hero-kicker">要记住ta说的话！</view>
    <view class="hero-title">{{sharedMessage}}</view>
    <view class="hero-footer">
      <view class="avatar-stack">
        <view class="avatar avatar-pink">她</view>
        <view class="avatar avatar-dark">他</view>
      </view>
      <view class="hero-note">点击修改共同留言</view>
    </view>
  </view>

  <view class="order-notice" wx:if="{{orderNotice && !activeOrder}}" bind:tap="openOrderNotice">
    <view class="notice-icon">♡</view>
    <view class="notice-content">
      <view class="notice-title">{{orderNotice.title}}</view>
      <view class="notice-items">{{orderNotice.itemText}}</view>
      <view class="notice-time">{{orderNotice.dateText}}</view>
    </view>
    <view class="notice-arrow">›</view>
  </view>

  <block wx:if="{{activeOrder}}">
    <view class="section-header active-order-header">
      <view>
        <view class="section-title">{{activeOrder.title}}</view>
        <view class="section-subtitle">{{activeOrder.dateText}} · {{activeOrder.status}}</view>
      </view>
      <view class="active-status">{{activeOrder.status}}</view>
    </view>

    <view class="active-order-card">
      <view class="active-order-item" wx:for="{{activeOrder.items}}" wx:key="menuItemId">
        <image class="active-item-image" wx:if="{{item.hasImage}}" src="{{item.image}}" mode="aspectFill" />
        <view
          class="active-item-image letter-avatar"
          wx:else
          style="background: {{item.avatarColor}};"
        >{{item.avatarText}}</view>
        <view class="active-item-info">
          <view class="active-item-name">{{item.name}}</view>
          <view class="active-item-cost">{{item.cost}}</view>
        </view>
        <view class="active-item-quantity">×{{item.quantity}}</view>
      </view>
      <view class="active-order-note" wx:if="{{activeOrder.note}}">“{{activeOrder.note}}”</view>
      <view class="active-order-response" wx:if="{{activeOrder.response}}">
        {{activeOrder.respondedByName}}：{{activeOrder.response}}
      </view>
      <view class="active-order-actions">
        <view class="waiting-text" wx:if="{{activeOrder.status === '等待回应' && activeOrder.isMine}}">
          已发给 TA，等待回应…
        </view>
        <block wx:if="{{activeOrder.canRespond}}">
          <view class="order-reject-button" bind:tap="rejectOrder">拒绝</view>
          <view class="order-action-button" bind:tap="acceptOrder">答应</view>
        </block>
        <view class="order-action-button complete-button" wx:if="{{activeOrder.canComplete}}" bind:tap="completeOrder">
          完成心愿
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="section-header">
      <view>
        <view class="section-title">想点什么</view>
        <view class="section-subtitle">选一个，开启今天的小约会</view>
      </view>
      <view class="section-more" bind:tap="chooseCategory" data-id="video">全部 →</view>
    </view>

    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-row">
        <view
          class="category-card"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bind:tap="chooseCategory"
        >
          <image
            class="category-icon category-icon-image"
            wx:if="{{item.hasImage}}"
            src="{{item.image}}"
            mode="aspectFill"
          />
          <view
            class="category-icon letter-avatar"
            wx:elif="{{item.avatarText}}"
            style="background: {{item.avatarColor}};"
          >{{item.avatarText}}</view>
          <view class="category-icon" wx:else>{{item.icon}}</view>
          <view class="category-name">{{item.name}}</view>
          <view class="category-subtitle">{{item.subtitle}}</view>
        </view>
      </view>
    </scroll-view>
  </block>

  <view class="section-header recommendation-header">
    <view>
      <view class="section-title">今日心动推荐</view>
      <view class="section-subtitle">不知道选什么，就从这里开始</view>
    </view>
  </view>

  <view class="recommendation-grid">
    <view class="menu-card" wx:for="{{featuredItems}}" wx:key="id">
      <view class="menu-image-wrap">
        <image class="menu-image" wx:if="{{item.hasImage}}" src="{{item.image}}" mode="aspectFill" />
        <view
          class="menu-image letter-avatar"
          wx:else
          style="background: {{item.avatarColor}};"
        >{{item.avatarText}}</view>
        <view class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
      </view>
      <view class="menu-content">
        <view class="menu-name">{{item.name}}</view>
        <view class="menu-description">{{item.description}}</view>
        <view class="menu-bottom">
          <view class="menu-price">{{item.cost}}</view>
          <view class="add-button" bind:tap="addItem" data-id="{{item.id}}">＋</view>
        </view>
      </view>
    </view>
  </view>

  <view class="response-mask" wx:if="{{showResponseSheet && responseAlert}}" catch:tap="closeResponseSheet">
    <view class="response-sheet" catch:tap="noop">
      <view class="response-sheet-handle"></view>
      <view class="response-sheet-title">{{responseAlert.title}}</view>
      <view class="response-sheet-items">{{responseAlert.itemText}}</view>
      <view class="response-sheet-bubble" wx:if="{{responseAlert.response}}">
        {{responseAlert.respondedByName}}：{{responseAlert.response}}
      </view>
      <view class="response-sheet-time">{{responseAlert.dateText}}</view>
      <view class="response-sheet-button" bind:tap="closeResponseSheet">知道了</view>
    </view>
  </view>
</view>
