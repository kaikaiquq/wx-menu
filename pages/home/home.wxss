page {
  min-height: 100%;
}

.home-page {
  background: var(--love-bg);
  box-sizing: border-box;
  color: var(--love-text);
  min-height: 100vh;
  padding: 36rpx var(--love-page-gutter) calc(var(--love-tab-height) + env(safe-area-inset-bottom) + 32rpx);
}

.page-loading {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  padding: 12rpx 0 24rpx;
  text-align: center;
}

.home-header {
  align-items: center;
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  padding-bottom: 36rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  line-height: 1.6;
}

.greeting-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.greeting {
  font-family: var(--love-heading-font);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
}

.wish-alert {
  align-items: center;
  background: var(--love-danger-soft);
  border-radius: var(--love-radius-control);
  color: var(--love-danger);
  display: flex;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  height: 80rpx;
  justify-content: center;
  width: 80rpx;
}

.wish-pill {
  align-items: center;
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-primary);
  display: flex;
  flex-shrink: 0;
  font-size: 24rpx;
  gap: 8rpx;
  min-height: 84rpx;
  justify-content: center;
  min-width: 84rpx;
  padding: 8rpx 16rpx;
}

.wish-icon {
  font-size: 38rpx;
  line-height: 1;
}

.hero-card {
  background: var(--love-primary);
  border-radius: var(--love-radius-card);
  box-sizing: border-box;
  color: var(--love-on-primary);
  min-height: 360rpx;
  overflow: hidden;
  padding: 36rpx;
}

.hero-kicker {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 1.6;
}

.hero-title {
  font-family: var(--love-heading-font);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.55;
  margin-top: 28rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.hero-footer {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: space-between;
  margin-top: 38rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid currentColor;
}

.hero-caption,
.hero-note {
  font-size: 22rpx;
  line-height: 1.5;
}

.hero-note {
  font-weight: 500;
}

.order-notice {
  align-items: center;
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  display: flex;
  margin-top: 24rpx;
  padding: 24rpx;
}

.notice-icon {
  align-items: center;
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  color: var(--love-primary);
  display: flex;
  flex: 0 0 72rpx;
  font-size: 36rpx;
  height: 72rpx;
  justify-content: center;
}

.notice-content {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.notice-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.notice-items {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-time {
  color: var(--love-text-muted);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.notice-arrow {
  color: var(--love-text-secondary);
  font-size: 40rpx;
}

.section-header {
  align-items: center;
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  margin: 48rpx 0 24rpx;
}

.section-header > view:first-child {
  flex: 1;
  min-width: 0;
}

.section-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.section-subtitle {
  color: var(--love-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 6rpx;
}

.section-more {
  align-items: center;
  color: var(--love-primary);
  display: flex;
  flex-shrink: 0;
  font-size: 24rpx;
  justify-content: flex-end;
  min-height: 80rpx;
  min-width: 100rpx;
}

.active-status {
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  color: var(--love-primary);
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 10rpx 16rpx;
}

.active-order-card {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  overflow: hidden;
  padding: 8rpx 26rpx 26rpx;
}

.active-order-item {
  align-items: center;
  border-bottom: 1rpx solid var(--love-border);
  display: flex;
  padding: 22rpx 0;
}

.active-item-image {
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  flex: 0 0 96rpx;
  height: 96rpx;
  width: 96rpx;
}

.active-item-image.letter-avatar {
  display: flex;
  font-size: 36rpx;
}

.active-item-info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.active-item-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.active-item-cost {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
  word-break: break-all;
}

.active-item-quantity {
  color: var(--love-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.active-order-note,
.active-order-response {
  background: var(--love-surface-muted);
  border-radius: var(--love-radius-control);
  color: var(--love-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
  margin-top: 20rpx;
  padding: 20rpx;
  word-break: break-all;
}

.active-order-response {
  background: var(--love-soft);
  color: var(--love-primary);
}

.active-order-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.waiting-text {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.order-reject-button,
.order-action-button {
  align-items: center;
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  display: flex;
  font-size: 26rpx;
  font-weight: 600;
  justify-content: center;
  min-height: 84rpx;
  min-width: 144rpx;
  padding: 16rpx 28rpx;
}

.order-reject-button {
  background: var(--love-surface);
  color: var(--love-text-secondary);
}

.order-action-button {
  background: var(--love-primary);
  border-color: var(--love-primary);
  color: var(--love-on-primary);
}

.response-mask {
  align-items: flex-end;
  background: var(--love-overlay);
  bottom: 0;
  display: flex;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}

.response-sheet {
  background: var(--love-surface);
  border-radius: var(--love-radius-card) var(--love-radius-card) 0 0;
  bottom: 0;
  box-sizing: border-box;
  left: 0;
  max-height: 88vh;
  overflow-y: auto;
  padding: 20rpx var(--love-page-gutter) calc(32rpx + env(safe-area-inset-bottom));
  position: absolute;
  right: 0;
}

.response-sheet-handle {
  background: var(--love-border);
  border-radius: 8rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  width: 64rpx;
}

.response-sheet-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}

.response-sheet-items {
  color: var(--love-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 16rpx;
  text-align: center;
  word-break: break-all;
}

.response-sheet-bubble {
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  color: var(--love-primary);
  font-size: 26rpx;
  line-height: 1.65;
  margin-top: 24rpx;
  padding: 24rpx;
  word-break: break-all;
}

.response-sheet-time {
  color: var(--love-text-muted);
  font-size: 22rpx;
  margin-top: 18rpx;
  text-align: center;
}

.response-sheet-button {
  align-items: center;
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  display: flex;
  font-size: 28rpx;
  font-weight: 600;
  justify-content: center;
  margin-top: 28rpx;
  min-height: 88rpx;
}

.category-scroll {
  width: 100%;
}

.category-row {
  display: flex;
  gap: 16rpx;
  padding-bottom: 2rpx;
}

.category-card {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  box-sizing: border-box;
  flex: 0 0 208rpx;
  padding: 24rpx;
}

.category-icon {
  align-items: center;
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  display: flex;
  font-size: 30rpx;
  height: 72rpx;
  justify-content: center;
  margin-bottom: 22rpx;
  overflow: hidden;
  width: 72rpx;
}

.category-icon-image {
  display: block;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.category-subtitle {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 6rpx;
  word-break: break-all;
}

.recommendation-grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.menu-card {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  min-width: 0;
  overflow: hidden;
}

.menu-image-wrap {
  height: 220rpx;
  position: relative;
}

.menu-image {
  display: block;
  height: 100%;
  width: 100%;
}

.menu-image.letter-avatar {
  display: flex;
  font-size: 60rpx;
}

.menu-badge {
  background: var(--love-surface);
  border-radius: var(--love-radius-control);
  color: var(--love-primary);
  font-size: 22rpx;
  left: 14rpx;
  line-height: 1.4;
  max-width: calc(100% - 56rpx);
  padding: 8rpx 14rpx;
  position: absolute;
  top: 14rpx;
  word-break: break-all;
}

.menu-content {
  padding: 22rpx 20rpx 18rpx;
}

.menu-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.menu-description {
  color: var(--love-text-secondary);
  display: -webkit-box;
  font-size: 23rpx;
  line-height: 1.55;
  min-height: 72rpx;
  margin-top: 10rpx;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.menu-bottom {
  align-items: center;
  display: flex;
  gap: 8rpx;
  justify-content: space-between;
  margin-top: 20rpx;
}

.menu-price {
  color: var(--love-primary);
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  min-width: 0;
  word-break: break-all;
}

.add-button {
  align-items: center;
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  display: flex;
  flex: 0 0 80rpx;
  font-size: 32rpx;
  height: 80rpx;
  justify-content: center;
  width: 80rpx;
}
