page {
  box-sizing: border-box;
  background: #f8f5f2;
  color: #292421;
  padding-bottom: calc(env(safe-area-inset-bottom) + 128rpx);
}

.home-page {
  background: var(--love-bg, #f8f5f2);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 0;
}

.page-loading {
  color: #a79c96;
  font-size: 21rpx;
  padding: 20rpx;
  text-align: center;
}

.home-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  padding: 12rpx 4rpx 30rpx;
}

.eyebrow {
  color: #a79c96;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.greeting {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 42rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.cart-pill {
  align-items: center;
  background: #292421;
  border-radius: 40rpx;
  color: #fff;
  display: flex;
  font-size: 22rpx;
  gap: 4rpx;
  height: 72rpx;
  justify-content: center;
  min-width: 72rpx;
  padding: 0 12rpx;
}

.cart-icon {
  font-size: 36rpx;
  line-height: 1;
}

.hero-card {
  background: linear-gradient(135deg, var(--love-hero-from, #df8f99), var(--love-hero-to, #c96f7e));
  border-radius: 36rpx;
  box-shadow: 0 22rpx 50rpx rgba(113, 61, 69, 0.18);
  color: #fff;
  min-height: 390rpx;
  overflow: hidden;
  padding: 42rpx;
  position: relative;
}

.hero-orbit {
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  position: absolute;
}

.orbit-one {
  height: 270rpx;
  right: -80rpx;
  top: -110rpx;
  width: 270rpx;
}

.orbit-two {
  bottom: -180rpx;
  height: 350rpx;
  left: -110rpx;
  width: 350rpx;
}

.hero-kicker {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  opacity: 0.8;
}

.hero-title {
  display: -webkit-box;
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.45;
  margin-top: 34rpx;
  overflow: hidden;
  position: relative;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.hero-footer {
  align-items: center;
  bottom: 36rpx;
  display: flex;
  justify-content: space-between;
  left: 42rpx;
  position: absolute;
  right: 42rpx;
}

.avatar-stack {
  display: flex;
}

.avatar {
  align-items: center;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  font-size: 20rpx;
  height: 54rpx;
  justify-content: center;
  width: 54rpx;
}

.avatar-dark {
  background: #423936;
  margin-left: -14rpx;
}

.avatar-pink {
  background: #f6d9dc;
  color: #a75461;
}

.hero-note {
  font-size: 22rpx;
  opacity: 0.85;
}

.section-header {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  margin: 54rpx 4rpx 24rpx;
}

.section-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 36rpx;
  font-weight: 600;
}

.section-subtitle {
  color: #a79c96;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.section-more {
  color: var(--love-primary, #ba6875);
  font-size: 23rpx;
  padding: 12rpx 0;
}

.category-scroll {
  margin-right: -28rpx;
  width: auto;
}

.category-row {
  display: flex;
  gap: 18rpx;
  padding: 0 28rpx 12rpx 0;
  width: max-content;
}

.category-card {
  background: #fff;
  border: 1rpx solid rgba(73, 58, 52, 0.06);
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(76, 58, 51, 0.05);
  box-sizing: border-box;
  padding: 26rpx 24rpx;
  width: 190rpx;
}

.category-icon {
  align-items: center;
  background: var(--love-soft, #f8eded);
  border-radius: 50%;
  display: flex;
  font-size: 34rpx;
  height: 68rpx;
  justify-content: center;
  margin-bottom: 20rpx;
  width: 68rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
}

.category-subtitle {
  color: #aaa09a;
  font-size: 19rpx;
  margin-top: 7rpx;
}

.recommendation-header {
  margin-top: 44rpx;
}

.recommendation-grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.menu-card {
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 34rpx rgba(75, 59, 53, 0.06);
  overflow: hidden;
}

.menu-image-wrap {
  height: 220rpx;
  position: relative;
}

.menu-image {
  height: 100%;
  width: 100%;
}

.menu-badge {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 18rpx;
  color: var(--love-primary-dark, #b55f6d);
  font-size: 18rpx;
  left: 16rpx;
  padding: 7rpx 13rpx;
  position: absolute;
  top: 16rpx;
}

.menu-content {
  padding: 22rpx;
}

.menu-name {
  font-size: 27rpx;
  font-weight: 600;
}

.menu-description {
  color: #9a918c;
  display: -webkit-box;
  font-size: 20rpx;
  height: 58rpx;
  line-height: 29rpx;
  margin-top: 9rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.menu-bottom {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.menu-price {
  color: var(--love-primary, #bb6572);
  font-size: 27rpx;
  font-weight: 600;
}

.menu-price text {
  color: #aaa09a;
  font-size: 18rpx;
  font-weight: 400;
}

.add-button {
  align-items: center;
  background: #292421;
  border-radius: 50%;
  color: #fff;
  display: flex;
  font-size: 30rpx;
  height: 52rpx;
  justify-content: center;
  width: 52rpx;
}
