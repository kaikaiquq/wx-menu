page {
  box-sizing: border-box;
  background: #f4f5f5;
  color: #292421;
  padding-bottom: calc(env(safe-area-inset-bottom) + 128rpx);
}

.home-page {
  background: var(--love-bg, #f4f5f5);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 0;
}

.page-loading {
  color: #a79c96;
  font-size: 21rpx;
  padding: 20rpx;
  text-align: center;
}

.home-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  padding: 12rpx 4rpx 30rpx;
}

.eyebrow {
  color: #a79c96;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.greeting-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.greeting {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 42rpx;
  font-weight: 600;
}

.wish-alert {
  align-items: center;
  background: #e34d4d;
  border-radius: 50%;
  color: #fff;
  display: flex;
  flex-shrink: 0;
  font-family: 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  font-weight: 700;
  height: 40rpx;
  justify-content: center;
  line-height: 1;
  width: 40rpx;
}

.wish-pill {
  align-items: center;
  background: #292421;
  border-radius: 40rpx;
  color: #fff;
  display: flex;
  font-size: 22rpx;
  gap: 4rpx;
  height: 72rpx;
  justify-content: center;
  min-width: 72rpx;
  padding: 0 12rpx;
}

.wish-icon {
  font-size: 36rpx;
  line-height: 1;
}

.hero-card {
  background: linear-gradient(135deg, var(--love-hero-from, #df8f99), var(--love-hero-to, #c96f7e));
  border-radius: 36rpx;
  box-shadow: 0 22rpx 50rpx rgba(113, 61, 69, 0.18);
  color: #fff;
  min-height: 390rpx;
  overflow: hidden;
  padding: 42rpx;
  position: relative;
}

.hero-orbit {
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  position: absolute;
}

.orbit-one {
  height: 270rpx;
  right: -80rpx;
  top: -110rpx;
  width: 270rpx;
}

.orbit-two {
  bottom: -180rpx;
  height: 350rpx;
  left: -110rpx;
  width: 350rpx;
}

.hero-kicker {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  opacity: 0.8;
}

.hero-title {
  display: -webkit-box;
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.45;
  margin-top: 34rpx;
  overflow: hidden;
  position: relative;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.hero-footer {
  align-items: center;
  bottom: 36rpx;
  display: flex;
  justify-content: space-between;
  left: 42rpx;
  position: absolute;
  right: 42rpx;
}

.avatar-stack {
  display: flex;
}

.avatar {
  align-items: center;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  font-size: 20rpx;
  height: 54rpx;
  justify-content: center;
  width: 54rpx;
}

.avatar-dark {
  background: #423936;
  margin-left: -14rpx;
}

.avatar-pink {
  background: #f6d9dc;
  color: #a75461;
}

.hero-note {
  font-size: 22rpx;
  opacity: 0.85;
}

.order-notice {
  align-items: center;
  background: #fff;
  border: 1rpx solid rgba(73, 58, 52, 0.06);
  border-radius: 26rpx;
  box-shadow: 0 12rpx 34rpx rgba(75, 59, 53, 0.07);
  display: flex;
  margin-top: 24rpx;
  padding: 22rpx;
}

.notice-icon {
  align-items: center;
  background: var(--love-soft, #f7e7e9);
  border-radius: 50%;
  color: var(--love-primary, #bd6875);
  display: flex;
  flex: 0 0 66rpx;
  font-size: 35rpx;
  height: 66rpx;
  justify-content: center;
}

.notice-content {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.notice-title {
  font-size: 25rpx;
  font-weight: 600;
}

.notice-items {
  color: #8f8580;
  font-size: 20rpx;
  margin-top: 7rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-time {
  color: #b2a8a2;
  font-size: 17rpx;
  margin-top: 6rpx;
}

.notice-arrow {
  color: #b8aea8;
  font-size: 40rpx;
}

.section-header {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  margin: 54rpx 4rpx 24rpx;
}

.section-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 36rpx;
  font-weight: 600;
}

.section-subtitle {
  color: #a79c96;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.section-more {
  color: var(--love-primary, #ba6875);
  font-size: 23rpx;
  padding: 12rpx 0;
}

.active-order-header {
  align-items: center;
}

.active-status {
  background: var(--love-soft, #f8eded);
  border-radius: 999rpx;
  color: var(--love-primary, #ba6875);
  font-size: 20rpx;
  padding: 10rpx 18rpx;
}

.active-order-card {
  background: #fff;
  border: 1rpx solid rgba(73, 58, 52, 0.06);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 34rpx rgba(75, 59, 53, 0.07);
  overflow: hidden;
  padding: 10rpx 26rpx 26rpx;
}

.active-order-item {
  align-items: center;
  border-bottom: 1rpx solid #f2eeeb;
  display: flex;
  padding: 20rpx 0;
}

.active-item-image {
  background: var(--love-soft, #f8eded);
  border-radius: 20rpx;
  flex: 0 0 92rpx;
  height: 92rpx;
  width: 92rpx;
}

.active-item-image.letter-avatar {
  display: flex;
  font-size: 34rpx;
}

.active-item-info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.active-item-name {
  font-size: 27rpx;
  font-weight: 600;
}

.active-item-cost {
  color: #a19892;
  font-size: 20rpx;
  margin-top: 7rpx;
}

.active-item-quantity {
  color: var(--love-primary, #ba6875);
  font-size: 23rpx;
  font-weight: 600;
}

.active-order-note,
.active-order-response {
  background: #f8f6f4;
  border-radius: 18rpx;
  color: #796f69;
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
}

.active-order-response {
  background: var(--love-soft, #f8eded);
  color: var(--love-primary, #ba6875);
}

.active-order-actions {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.waiting-text {
  color: #aaa09a;
  font-size: 21rpx;
}

.order-reject-button {
  border: 1rpx solid #d9a4ab;
  border-radius: 999rpx;
  color: var(--love-primary, #ba6875);
  font-size: 23rpx;
  font-weight: 600;
  padding: 16rpx 30rpx;
}

.order-action-button {
  background: var(--love-primary, #ba6875);
  border-radius: 999rpx;
  color: #fff;
  font-size: 23rpx;
  font-weight: 600;
  padding: 18rpx 34rpx;
}

.response-mask {
  align-items: flex-end;
  background: rgba(30, 24, 22, 0.45);
  bottom: 0;
  display: flex;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}

.response-sheet {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  left: 0;
  padding: 18rpx 36rpx 28rpx;
  position: absolute;
  right: 0;
  width: 100%;
}

.response-sheet-handle {
  background: #e4ddda;
  border-radius: 8rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  width: 64rpx;
}

.response-sheet-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.response-sheet-items {
  color: #8f8580;
  font-size: 22rpx;
  margin-top: 16rpx;
  text-align: center;
}

.response-sheet-bubble {
  background: var(--love-soft, #f8eded);
  border-radius: 18rpx;
  color: var(--love-primary, #ba6875);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
}

.response-sheet-time {
  color: #b2a8a2;
  font-size: 18rpx;
  margin-top: 14rpx;
  text-align: center;
}

.response-sheet-button {
  background: var(--love-primary, #ba6875);
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 28rpx;
  padding: 20rpx 0;
  text-align: center;
}

.complete-button::before {
  content: '♡ ';
}

.category-scroll {
  margin-right: -28rpx;
  width: auto;
}

.category-row {
  display: flex;
  gap: 18rpx;
  padding: 0 28rpx 12rpx 0;
  width: max-content;
}

.category-card {
  background: #fff;
  border: 1rpx solid rgba(73, 58, 52, 0.06);
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(76, 58, 51, 0.05);
  box-sizing: border-box;
  padding: 26rpx 24rpx;
  width: 190rpx;
}

.category-icon {
  align-items: center;
  background: var(--love-soft, #f8eded);
  border-radius: 50%;
  display: flex;
  font-size: 28rpx;
  height: 68rpx;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
  width: 68rpx;
}

.category-icon-image {
  display: block;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
}

.category-subtitle {
  color: #aaa09a;
  font-size: 19rpx;
  margin-top: 7rpx;
}

.recommendation-header {
  margin-top: 44rpx;
}

.recommendation-grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.menu-card {
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 34rpx rgba(75, 59, 53, 0.06);
  overflow: hidden;
}

.menu-image-wrap {
  height: 220rpx;
  position: relative;
}

.menu-image {
  height: 100%;
  width: 100%;
}

.menu-image.letter-avatar {
  display: flex;
  font-size: 56rpx;
}

.menu-badge {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 18rpx;
  color: var(--love-primary-dark, #b55f6d);
  font-size: 18rpx;
  left: 16rpx;
  padding: 7rpx 13rpx;
  position: absolute;
  top: 16rpx;
}

.menu-content {
  padding: 22rpx;
}

.menu-name {
  font-size: 27rpx;
  font-weight: 600;
}

.menu-description {
  color: #9a918c;
  display: -webkit-box;
  font-size: 20rpx;
  height: 58rpx;
  line-height: 29rpx;
  margin-top: 9rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.menu-bottom {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.menu-price {
  color: var(--love-primary, #bb6572);
  font-size: 27rpx;
  font-weight: 600;
}

.menu-price text {
  color: #aaa09a;
  font-size: 18rpx;
  font-weight: 400;
}

.add-button {
  align-items: center;
  background: #292421;
  border-radius: 50%;
  color: #fff;
  display: flex;
  font-size: 30rpx;
  height: 52rpx;
  justify-content: center;
  width: 52rpx;
}
