.admin-page {
  background: var(--love-bg);
  box-sizing: border-box;
  color: var(--love-text);
  min-height: 100vh;
  padding: 48rpx var(--love-page-gutter) calc(168rpx + env(safe-area-inset-bottom));
}

.admin-heading {
  padding-bottom: 12rpx;
}

.admin-eyebrow {
  color: var(--love-primary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.admin-title {
  font-family: var(--love-heading-font);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-top: 12rpx;
}

.admin-subtitle,
.section-note {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
  margin-top: 12rpx;
}

.section-heading {
  margin: 40rpx 0 22rpx;
}

.section-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.form-card,
.manager-list {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  padding: 28rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.field-item {
  flex: 1;
  min-width: 0;
}

.field-item-full {
  border-top: 1rpx solid var(--love-border);
  margin-top: 28rpx;
  padding-top: 28rpx;
}

.field-label {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.field-input {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text);
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  width: 100%;
}

.date-picker {
  align-items: center;
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  display: flex;
  font-size: 26rpx;
  gap: 16rpx;
  justify-content: space-between;
  line-height: 1.5;
  padding: 24rpx;
}

.date-picker text {
  color: var(--love-primary);
  flex-shrink: 0;
  font-size: 24rpx;
}

.manager-list {
  overflow: hidden;
  padding: 0 28rpx;
}

.manager-entry {
  align-items: center;
  border-bottom: 1rpx solid var(--love-border);
  display: flex;
  padding: 28rpx 0;
}

.manager-entry:last-child {
  border-bottom: 0;
}

.manager-icon {
  align-items: center;
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  color: var(--love-primary);
  display: flex;
  flex-shrink: 0;
  font-size: 32rpx;
  height: 72rpx;
  justify-content: center;
  margin-right: 22rpx;
  width: 72rpx;
}

.manager-info {
  flex: 1;
  min-width: 0;
}

.manager-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.manager-note {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 6rpx;
}

.manager-count {
  color: var(--love-text-muted);
  flex-shrink: 0;
  font-size: 22rpx;
  margin-left: 12rpx;
}

.manager-arrow {
  color: var(--love-text-muted);
  flex-shrink: 0;
  font-size: 34rpx;
  margin-left: 16rpx;
}

.danger-zone {
  align-items: center;
  border-top: 1rpx solid var(--love-border);
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  margin-top: 36rpx;
  padding: 28rpx 0;
}

.danger-copy {
  flex: 1;
  min-width: 0;
}

.danger-title {
  color: var(--love-danger);
  font-size: 26rpx;
  font-weight: 600;
}

.danger-note {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.65;
  margin-top: 8rpx;
}

.clear-button {
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  color: var(--love-danger);
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 20rpx;
  white-space: nowrap;
}

.admin-footer {
  background: var(--love-surface);
  border-top: 1rpx solid var(--love-border);
  bottom: 0;
  left: 0;
  padding: 20rpx var(--love-page-gutter) calc(20rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 20;
}

.save-button,
.picker-submit {
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  padding: 24rpx;
  text-align: center;
}

.save-button-disabled {
  opacity: 0.55;
}

.picker-mask {
  background: var(--love-overlay);
  bottom: 0;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}

.personal-picker {
  background: var(--love-surface);
  border-radius: var(--love-radius-card) var(--love-radius-card) 0 0;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  left: 0;
  max-height: 88vh;
  overflow: hidden;
  padding: 18rpx var(--love-page-gutter) calc(24rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 1001;
}

.picker-handle {
  background: var(--love-border);
  border-radius: 8rpx;
  flex-shrink: 0;
  height: 6rpx;
  margin: 0 auto 30rpx;
  width: 56rpx;
}

.picker-heading {
  align-items: flex-start;
  display: flex;
  flex-shrink: 0;
  gap: 20rpx;
  justify-content: space-between;
}

.picker-heading-copy {
  flex: 1;
  min-width: 0;
}

.picker-title {
  font-family: var(--love-heading-font);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.picker-note,
.picker-item-cost,
.picker-empty {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  word-break: break-all;
}

.picker-close {
  align-items: center;
  background: var(--love-surface-muted);
  border-radius: 50%;
  color: var(--love-text-secondary);
  display: flex;
  flex-shrink: 0;
  font-size: 40rpx;
  height: 88rpx;
  justify-content: center;
  line-height: 1;
  width: 88rpx;
}

.picker-list {
  flex-shrink: 1;
  height: 48vh;
  margin-top: 28rpx;
  min-height: 0;
}

.picker-item {
  align-items: center;
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  display: flex;
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.picker-item-selected {
  background: var(--love-soft);
  border-color: var(--love-primary);
}

.picker-image {
  background: var(--love-surface-muted);
  border-radius: var(--love-radius-control);
  flex-shrink: 0;
  height: 88rpx;
  width: 88rpx;
}

.picker-info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.picker-item-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.picker-check {
  align-items: center;
  border: 1rpx solid var(--love-border);
  border-radius: 50%;
  color: var(--love-primary);
  display: flex;
  flex-shrink: 0;
  font-size: 24rpx;
  height: 40rpx;
  justify-content: center;
  width: 40rpx;
}

.picker-item-selected .picker-check {
  background: var(--love-primary);
  border-color: var(--love-primary);
  color: var(--love-on-primary);
}

.picker-submit {
  flex-shrink: 0;
  margin-top: 24rpx;
}

.picker-empty {
  padding: 60rpx 20rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .field-row {
    flex-direction: column;
  }
}
