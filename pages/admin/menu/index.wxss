@import '../shared.wxss';

.add-item-button {
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 36rpx;
  padding: 20rpx 24rpx;
  white-space: nowrap;
}

.item-list {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  overflow: hidden;
  padding: 0 24rpx;
}

.admin-item {
  align-items: center;
  border-bottom: 1rpx solid var(--love-border);
  display: flex;
  padding: 24rpx 0;
}

.admin-item:last-child {
  border-bottom: 0;
}

.admin-item-image {
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  flex: 0 0 112rpx;
  height: 112rpx;
  width: 112rpx;
}

.admin-item-image.letter-avatar {
  display: flex;
  font-size: 36rpx;
}

.admin-item-info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.admin-item-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.admin-item-cost {
  color: var(--love-primary);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
  word-break: break-all;
}

.admin-item-actions {
  align-items: flex-end;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.item-edit,
.item-delete {
  font-size: 24rpx;
  line-height: 1.5;
  padding: 14rpx 4rpx 14rpx 12rpx;
}

.item-edit {
  color: var(--love-primary);
}

.item-delete {
  color: var(--love-danger);
}

.empty-menu {
  align-items: center;
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  display: flex;
  flex-direction: column;
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-icon {
  color: var(--love-primary);
  font-family: var(--love-heading-font);
  font-size: 64rpx;
  line-height: 1.1;
}

.empty-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 24rpx;
}

.empty-note {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}

.retry-button {
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  font-size: 26rpx;
  margin-top: 28rpx;
  padding: 22rpx 36rpx;
}

.item-editor {
  bottom: 0;
  left: 0;
  position: fixed;
  right: 0;
  z-index: 1001;
}

.editor-header {
  align-items: flex-start;
  display: flex;
  flex-shrink: 0;
  gap: 20rpx;
  justify-content: space-between;
  padding-bottom: 28rpx;
}

.editor-header-copy {
  flex: 1;
  min-width: 0;
}

.editor-close {
  align-items: center;
  background: var(--love-surface-muted);
  border-radius: 50%;
  color: var(--love-text-secondary);
  display: flex;
  flex-shrink: 0;
  font-size: 40rpx;
  height: 88rpx;
  justify-content: center;
  line-height: 1;
  width: 88rpx;
}

.editor-scroll {
  flex-shrink: 1;
  height: 58vh;
  min-height: 0;
}

.editor-input-highlight {
  border-color: var(--love-primary);
  color: var(--love-primary-dark);
}

.editor-picker {
  align-items: center;
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  display: flex;
  font-size: 28rpx;
  gap: 16rpx;
  justify-content: space-between;
  line-height: 1.5;
  padding: 24rpx;
  word-break: break-all;
}

.editor-picker text {
  color: var(--love-primary);
  flex-shrink: 0;
  font-size: 24rpx;
}

.editor-save {
  margin-bottom: 8rpx;
}

.template-row {
  align-items: center;
  border-bottom: 1rpx solid var(--love-border);
  display: flex;
  padding: 22rpx 0;
}

.template-row:first-child {
  padding-top: 0;
}

.template-row:last-child {
  border-bottom: 0;
}

.template-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
