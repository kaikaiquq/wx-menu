@import '../shared.wxss';

.category-list {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  overflow: hidden;
  padding: 0 28rpx;
}

.category-list:empty {
  display: none;
}

.category-item {
  align-items: center;
  border-bottom: 1rpx solid var(--love-border);
  display: flex;
  gap: 20rpx;
  padding: 26rpx 0;
}

.category-item:last-child {
  border-bottom: 0;
}

.category-main {
  align-items: center;
  display: flex;
  flex: 1;
  min-width: 0;
}

.category-copy {
  flex: 1;
  min-width: 0;
}

.category-cover {
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  flex-shrink: 0;
  font-size: 30rpx;
  height: 84rpx;
  margin-right: 24rpx;
  width: 84rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.category-note {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.55;
  margin-top: 6rpx;
  word-break: break-all;
}

.category-delete {
  color: var(--love-danger);
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 24rpx 0 24rpx 12rpx;
}

.add-category {
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 32rpx;
  padding: 25rpx;
  text-align: center;
}

.template-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding-bottom: 4rpx;
}

.template-card {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  padding: 24rpx;
}

.template-name {
  margin-top: 20rpx;
}

.category-editor-scroll {
  flex-shrink: 1;
  height: 54vh;
  margin-top: 28rpx;
  min-height: 0;
}
