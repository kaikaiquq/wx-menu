<view class="admin-page {{themeClass}}">
  <view class="admin-heading">
    <view class="admin-eyebrow">EASY SETUP</view>
    <view class="admin-title">内容管理</view>
    <view class="admin-subtitle">这里的修改只是草稿，点击底部保存后才会生效</view>
  </view>

  <view class="draft-tip">
    <view class="draft-dot"></view>
    <view>
      <view class="draft-title">草稿模式</view>
      <view class="draft-description">直接返回不会保存本次修改</view>
    </view>
  </view>

  <view class="section-heading">
    <view>
      <view class="section-title">我们的资料</view>
      <view class="section-note">会展示在“我们”页面</view>
    </view>
  </view>

  <view class="form-card">
    <view class="field-row">
      <view class="field-item">
        <view class="field-label">她的昵称</view>
        <input
          class="field-input"
          value="{{profile.herName}}"
          maxlength="8"
          data-field="herName"
          bindinput="updateProfile"
        />
      </view>
      <view class="field-item">
        <view class="field-label">他的昵称</view>
        <input
          class="field-input"
          value="{{profile.hisName}}"
          maxlength="8"
          data-field="hisName"
          bindinput="updateProfile"
        />
      </view>
    </view>
    <view class="field-item field-item-full">
      <view class="field-label">在一起的第一天</view>
      <picker mode="date" value="{{profile.anniversary}}" bindchange="changeAnniversary">
        <view class="date-picker">{{profile.anniversary}} <text>选择日期 ›</text></view>
      </picker>
    </view>
  </view>

  <view class="section-heading">
    <view>
      <view class="section-title">内容配置</view>
      <view class="section-note">进入独立页面管理，界面更清晰</view>
    </view>
  </view>

  <view class="manager-list">
    <view class="manager-entry" bind:tap="openCategoryManager">
      <view class="manager-icon manager-icon-category">◫</view>
      <view class="manager-info">
        <view class="manager-title">分类管理</view>
        <view class="manager-note">新增、重命名和删除分类</view>
      </view>
      <view class="manager-count">{{categoryCount}} 个</view>
      <view class="manager-arrow">›</view>
    </view>
    <view class="manager-entry" bind:tap="openMenuManager">
      <view class="manager-icon manager-icon-menu">♡</view>
      <view class="manager-info">
        <view class="manager-title">菜单管理</view>
        <view class="manager-note">管理点单内容与图片</view>
      </view>
      <view class="manager-count">{{menuCount}} 项</view>
      <view class="manager-arrow">›</view>
    </view>
  </view>

  <view class="danger-zone">
    <view>
      <view class="danger-title">清空全部内容</view>
      <view class="danger-note">清空所有分类和点单项，不影响双方资料</view>
    </view>
    <view class="clear-button" bind:tap="clearAll">全部清空</view>
  </view>

  <view class="admin-footer">
    <view class="save-button {{saving ? 'save-button-disabled' : ''}}" bind:tap="saveAll">
      {{saving ? '正在上传并保存...' : '保存并立即生效'}}
    </view>
  </view>
</view>
