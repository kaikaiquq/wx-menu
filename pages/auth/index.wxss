.auth-page {
  background: var(--love-bg);
  box-sizing: border-box;
  color: var(--love-text);
  min-height: 100vh;
  padding: 48rpx var(--love-page-gutter) calc(48rpx + env(safe-area-inset-bottom));
}

.auth-page button::after {
  border: 0;
}

.auth-brand {
  padding: 16rpx 0 48rpx;
}

.brand-heart {
  align-items: center;
  border: 1rpx solid var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-primary);
  display: flex;
  font-size: 50rpx;
  height: 88rpx;
  justify-content: center;
  line-height: 1;
  width: 88rpx;
}

.brand-title {
  font-family: var(--love-heading-font);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.3;
  margin-top: 28rpx;
}

.brand-note,
.card-note,
.error-note {
  color: var(--love-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 16rpx;
  word-break: break-all;
}

.auth-card,
.error-card,
.loading-card {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  padding: 36rpx 32rpx;
}

.loading-card {
  color: var(--love-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.card-step {
  color: var(--love-primary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

.card-title,
.error-title {
  font-family: var(--love-heading-font);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
}

.avatar-button {
  background: transparent;
  border-radius: 50%;
  display: block;
  height: 132rpx;
  margin: 36rpx auto 28rpx;
  padding: 0;
  width: 132rpx;
}

.avatar-image,
.avatar-placeholder {
  border-radius: 50%;
  height: 132rpx;
  width: 132rpx;
}

.avatar-placeholder {
  align-items: center;
  background: var(--love-soft);
  border: 1rpx solid var(--love-border);
  box-sizing: border-box;
  color: var(--love-primary);
  display: flex;
  font-size: 48rpx;
  justify-content: center;
}

.nickname-input,
.invite-input {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text);
  font-size: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 24rpx;
  text-align: center;
  width: 100%;
}

.anniversary-label,
.gender-label {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  margin: 28rpx 0 14rpx;
}

.anniversary-picker {
  align-items: center;
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  display: flex;
  font-size: 26rpx;
  gap: 16rpx;
  justify-content: space-between;
  line-height: 1.5;
  padding: 24rpx;
}

.anniversary-picker text {
  color: var(--love-primary);
  flex-shrink: 0;
  font-size: 22rpx;
}

.invite-input {
  font-weight: 600;
  letter-spacing: 2rpx;
}

.invite-input-prefilled {
  background: var(--love-soft);
  color: var(--love-primary-dark);
  font-size: 34rpx;
  letter-spacing: 6rpx;
  margin-top: 28rpx;
}

.primary-button,
.secondary-button,
.retry-button {
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 28rpx;
  min-height: 96rpx;
  padding: 27rpx 20rpx;
  text-align: center;
  width: 100%;
}

.primary-button {
  background: var(--love-primary);
  color: var(--love-on-primary);
}

.primary-button[disabled],
.secondary-button[disabled] {
  background: var(--love-surface-muted);
  color: var(--love-text-muted);
}

.secondary-button,
.retry-button {
  background: var(--love-soft);
  color: var(--love-primary-dark);
}

.gender-picker {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
}

.gender-option {
  border-radius: var(--love-radius-control);
  color: var(--love-text-secondary);
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  padding: 20rpx;
  text-align: center;
}

.gender-option-active {
  background: var(--love-primary);
  color: var(--love-on-primary);
  font-weight: 600;
}

.gender-help {
  color: var(--love-text-muted);
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 14rpx;
}

.divider {
  align-items: center;
  color: var(--love-text-muted);
  display: flex;
  font-size: 22rpx;
  gap: 20rpx;
  margin: 36rpx 0;
}

.divider::before,
.divider::after {
  background: var(--love-border);
  content: '';
  flex: 1;
  height: 1rpx;
}

.invite-code {
  background: var(--love-soft);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  color: var(--love-primary-dark);
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 7rpx;
  line-height: 1.4;
  margin-top: 32rpx;
  padding: 32rpx 12rpx;
  text-align: center;
  word-break: break-all;
}

.invite-code-empty {
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.retry-link {
  color: var(--love-primary);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 16rpx;
  padding: 16rpx 0;
  text-align: center;
}
