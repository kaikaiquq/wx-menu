<view class="chat-page {{themeClass}}">
  <view class="chat-layout">
    <view class="chat-sidebar {{showFriends ? 'expanded' : ''}}">
      <block wx:if="{{!showFriends}}">
        <scroll-view class="conversation-scroll" scroll-y>
          <view wx:if="{{loading}}" class="sidebar-empty">…</view>
          <view wx:elif="{{!conversations.length}}" class="sidebar-empty">空</view>
          <view
            class="conversation-item {{activeId === item.id ? 'active' : ''}} {{item.isCouple ? 'couple' : ''}}"
            wx:for="{{conversations}}"
            wx:key="id"
            data-id="{{item.id}}"
            bind:tap="selectConversation"
          >
            <view class="conversation-avatar-wrap">
              <image
                class="conversation-avatar"
                wx:if="{{item.peer.openid && avatarMap[item.peer.openid]}}"
                src="{{avatarMap[item.peer.openid]}}"
                mode="aspectFill"
              />
              <view class="conversation-avatar conversation-avatar-fallback" wx:else>
                {{item.isCouple ? '♡' : (item.type === 'group' ? '群' : (item.title[0] || '友'))}}
              </view>
              <view class="unread-badge" wx:if="{{item.unreadCount > 0 && activeId !== item.id}}">
                {{item.unreadCount > 99 ? '99+' : item.unreadCount}}
              </view>
              <view class="couple-badge" wx:if="{{item.isCouple}}">对象</view>
            </view>
          </view>
        </scroll-view>
        <view class="sidebar-friends-btn" bind:tap="openFriendsPanel">
          <view class="friends-icon" aria-label="好友">
            <view class="friends-people">
              <view class="people-person people-back">
                <view class="people-head"></view>
                <view class="people-body"></view>
              </view>
              <view class="people-person people-front">
                <view class="people-head"></view>
                <view class="people-body"></view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="friends-panel" catch:tap="noop">
          <view class="friends-panel-head">
            <view class="friends-panel-title">好友</view>
            <view class="friends-panel-close" bind:tap="closeFriendsPanel">收起</view>
          </view>

          <view class="friends-search-row">
            <input
              class="friends-search"
              value="{{friendKeyword}}"
              placeholder="搜索好友昵称 / ID"
              maxlength="32"
              bindinput="updateFriendKeyword"
            />
          </view>

          <view class="friends-add-row">
            <input
              class="friends-add-input"
              value="{{addId}}"
              maxlength="32"
              placeholder="输入对方用户 ID 添加好友"
              bindinput="updateAddId"
            />
            <view class="friends-add-btn" bind:tap="submitAddFriend">添加</view>
          </view>

          <view class="my-id-line" bind:tap="copyMyId">
            轻点复制id· {{myPublicUserId || '—'}}
          </view>

          <view class="friends-group-btn" bind:tap="openCreateGroup">发起群聊</view>

          <scroll-view class="friends-list-scroll" scroll-y>
            <view class="friends-list-card">
              <view class="friends-section" wx:if="{{incoming.length}}">
                <view class="friends-section-title">新申请</view>
                <view class="friend-row" wx:for="{{incoming}}" wx:key="id">
                  <view class="friend-info">
                    <view class="friend-name">{{item.from.nickname}}</view>
                    <view class="friend-sub">{{item.from.publicUserId}}</view>
                  </view>
                  <view class="friend-actions">
                    <view class="mini-btn" data-id="{{item.id}}" bind:tap="rejectRequest">拒绝</view>
                    <view class="mini-btn primary" data-id="{{item.id}}" bind:tap="acceptRequest">同意</view>
                  </view>
                </view>
              </view>

              <view class="friends-section-title">好友列表</view>
              <view wx:if="{{!filteredFriends.length}}" class="friends-empty">暂无好友</view>
              <view class="friend-row" wx:for="{{filteredFriends}}" wx:key="openid">
                <image
                  class="friend-avatar"
                  wx:if="{{avatarMap[item.openid]}}"
                  src="{{avatarMap[item.openid]}}"
                  mode="aspectFill"
                />
                <view class="friend-avatar friend-avatar-fallback" wx:else>{{item.nickname[0] || '友'}}</view>
                <view class="friend-info" data-openid="{{item.openid}}" bind:tap="chatFriend">
                  <view class="friend-name">{{item.nickname}}</view>
                  <view class="friend-sub">{{item.publicUserId}}</view>
                </view>
                <view
                  class="mini-btn danger"
                  data-openid="{{item.openid}}"
                  data-name="{{item.nickname}}"
                  bind:tap="removeFriendConfirm"
                >删除</view>
              </view>
            </view>
          </scroll-view>
        </view>
      </block>
    </view>

    <view class="chat-main">
      <view class="chat-header" bind:tap="dismissComposerExtras">
        <view class="chat-header-title">{{activeTitle}}</view>
      </view>

      <view class="message-wrap">
        <scroll-view
          class="message-scroll"
          scroll-y
          scroll-into-view="{{scrollIntoView}}"
          scroll-with-animation="{{false}}"
          bind:tap="dismissComposerExtras"
        >
          <view wx:if="{{activeId && !messages.length}}" class="message-empty">还没有消息</view>
          <view
            class="message-row {{item.isMine ? 'mine' : ''}} {{item.fromOpenid === 'system' ? 'system' : ''}}"
            wx:for="{{messages}}"
            wx:key="id"
            id="msg-{{index}}"
          >
            <block wx:if="{{item.fromOpenid !== 'system'}}">
              <!-- 对方：头像在左 -->
              <view class="msg-avatar-wrap" wx:if="{{!item.isMine}}">
                <image
                  class="msg-avatar"
                  wx:if="{{avatarMap[item.fromOpenid]}}"
                  src="{{avatarMap[item.fromOpenid]}}"
                  mode="aspectFill"
                />
                <view class="msg-avatar msg-avatar-fallback" wx:else>
                  {{item.fromNickname[0] || '友'}}
                </view>
              </view>

              <view class="msg-body">
                <view class="msg-meta" wx:if="{{!item.isMine}}">
                  <text class="msg-name">{{item.fromNickname}}</text>
                  <text class="msg-time">{{item.timeText}}</text>
                </view>
                <view class="msg-meta mine-meta" wx:else>
                  <text class="msg-time">{{item.timeText}}</text>
                </view>
                <view class="message-bubble" wx:if="{{item.msgType === 'text'}}">
                  <view class="message-text">{{item.text}}</view>
                </view>
                <view
                  class="message-bubble image-bubble"
                  wx:elif="{{item.msgType === 'image'}}"
                  data-url="{{item.imageUrl || imageUrlMap[item.imageFileId] || item.imageFileId}}"
                  catch:tap="previewChatImage"
                >
                  <image
                    class="chat-image"
                    src="{{item.imageUrl || imageUrlMap[item.imageFileId] || item.imageFileId}}"
                    mode="aspectFit"
                    lazy-load
                  />
                </view>
                <view
                  class="message-bubble voice-bubble"
                  wx:elif="{{item.msgType === 'voice'}}"
                  data-id="{{item.id}}"
                  data-file="{{item.voiceFileId}}"
                  catch:tap="playVoice"
                >
                  <view class="voice-wave {{playingVoiceId === item.id ? 'playing' : ''}}">
                    <view class="voice-bar"></view>
                    <view class="voice-bar"></view>
                    <view class="voice-bar"></view>
                  </view>
                  <view class="voice-duration">{{item.voiceDuration || 1}}"</view>
                </view>
              </view>

              <!-- 自己：头像在右，时间在头像左侧（meta 右对齐） -->
              <view class="msg-avatar-wrap" wx:if="{{item.isMine}}">
                <image
                  class="msg-avatar"
                  wx:if="{{avatarMap[myOpenid]}}"
                  src="{{avatarMap[myOpenid]}}"
                  mode="aspectFill"
                />
                <view class="msg-avatar msg-avatar-fallback" wx:else>我</view>
              </view>
            </block>
            <view class="system-text" wx:else>{{item.text}}</view>
          </view>
        </scroll-view>
        <view class="friends-dismiss-mask" wx:if="{{showFriends}}" bind:tap="closeFriendsPanel"></view>
      </view>

      <view class="composer-wrap" wx:if="{{activeId}}">
        <view class="composer">
          <view class="composer-tool" catch:tap="toggleVoiceMode" aria-label="{{voiceMode ? '键盘' : '语音'}}">
            <view class="tool-glyph {{voiceMode ? 'glyph-keyboard' : 'glyph-mic'}}"></view>
          </view>

          <input
            wx:if="{{!voiceMode}}"
            class="composer-input"
            value="{{draft}}"
            maxlength="500"
            confirm-type="send"
            placeholder="说点什么…"
            focus="{{inputFocus}}"
            adjust-position="{{true}}"
            hold-keyboard="{{false}}"
            bindinput="updateDraft"
            bindconfirm="submitMessage"
            bindfocus="onInputFocus"
            bindblur="onInputBlur"
          />
          <view
            wx:else
            class="voice-hold {{recording ? 'recording' : ''}} {{voiceCancelReady ? 'cancel-ready' : ''}}"
            bindtouchstart="onVoiceTouchStart"
            bindtouchmove="onVoiceTouchMove"
            bindtouchend="onVoiceTouchEnd"
            bindtouchcancel="onVoiceTouchCancel"
          >
            {{recording ? (voiceCancelReady ? '松开取消' : '松开发送') : '按住 说话'}}
          </view>

          <view
            class="composer-tool {{showEmoji ? 'active' : ''}}"
            catch:tap="toggleEmojiPanel"
            aria-label="表情"
          >
            <view class="tool-glyph glyph-emoji"></view>
          </view>

          <view class="composer-tool" catch:tap="openImagePicker" aria-label="图片">
            <view class="tool-glyph glyph-image"></view>
          </view>

          <view
            class="composer-send {{draft || sending ? '' : 'disabled'}}"
            catch:tap="submitMessage"
            aria-label="发送"
          >
            <view class="tool-glyph glyph-send"></view>
          </view>
        </view>

        <view class="emoji-panel" wx:if="{{showEmoji}}" catch:tap="noop">
          <scroll-view class="emoji-scroll" scroll-y>
            <view class="emoji-grid">
              <view
                class="emoji-item"
                wx:for="{{emojiList}}"
                wx:key="*this"
                data-emoji="{{item}}"
                catch:tap="insertEmoji"
              >{{item}}</view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>

  <!-- 按住说话提示层（类微信） -->
  <view class="voice-overlay {{voiceCancelReady ? 'is-cancel' : ''}}" wx:if="{{showVoiceOverlay}}" catch:touchmove="noop">
    <view class="voice-overlay-card">
      <view class="voice-overlay-mic">
        <view class="voice-overlay-wave">
          <view class="vov-bar"></view>
          <view class="vov-bar"></view>
          <view class="vov-bar"></view>
          <view class="vov-bar"></view>
          <view class="vov-bar"></view>
        </view>
      </view>
      <view class="voice-overlay-title">
        {{voiceCancelReady ? '松开手指，取消发送' : '松开发送'}}
      </view>
      <view class="voice-overlay-sub" wx:if="{{!voiceCancelReady}}">手指上滑，取消发送</view>
    </view>
  </view>
</view>
