.composer-input {
  background: var(--love-soft, #f6f3f1);
  border-radius: 14rpx;
  flex: 1;
  font-size: 26rpx;
  height: 60rpx;
  min-width: 0;
  padding: 0 18rpx;
}

.voice-hold {
  align-items: center;
  background: var(--love-soft, #f6f3f1);
  border-radius: 14rpx;
  color: #5c5550;
  display: flex;
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  height: 60rpx;
  justify-content: center;
  min-width: 0;
  user-select: none;
}

.voice-hold.recording {
  background: var(--love-soft-strong, #f2dcdf);
  color: var(--love-primary-dark, #a95360);
}

.voice-hold.cancel-ready {
  background: rgba(250, 81, 81, 0.12);
  color: #d93838;
}

.composer-send {
  align-items: center;
  background: var(--love-primary, #bd6875);
  border-radius: 14rpx;
  display: flex;
  flex-shrink: 0;
  height: 60rpx;
  justify-content: center;
  width: 60rpx;
}

.composer-send.disabled {
  opacity: 0.35;
}

.voice-overlay {
  align-items: center;
  background: rgba(20, 18, 16, 0.45);
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  padding-bottom: 220rpx;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}

.voice-overlay-card {
  align-items: center;
  background: rgba(45, 40, 38, 0.92);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  min-width: 320rpx;
  padding: 40rpx 48rpx 36rpx;
}

.voice-overlay.is-cancel .voice-overlay-card {
  background: rgba(180, 48, 48, 0.92);
}

.voice-overlay-mic {
  align-items: center;
  display: flex;
  height: 120rpx;
  justify-content: center;
  margin-bottom: 24rpx;
  width: 180rpx;
}

.voice-overlay-wave {
  align-items: flex-end;
  display: flex;
  gap: 10rpx;
  height: 72rpx;
}

.vov-bar {
  animation: voiceOverlayPulse 0.9s ease-in-out infinite;
  background: #fff;
  border-radius: 6rpx;
  width: 10rpx;
}

.vov-bar:nth-child(1) {
  animation-delay: 0s;
  height: 28rpx;
}

.vov-bar:nth-child(2) {
  animation-delay: 0.1s;
  height: 48rpx;
}

.vov-bar:nth-child(3) {
  animation-delay: 0.2s;
  height: 68rpx;
}

.vov-bar:nth-child(4) {
  animation-delay: 0.15s;
  height: 40rpx;
}

.vov-bar:nth-child(5) {
  animation-delay: 0.05s;
  height: 24rpx;
}

.voice-overlay.is-cancel .vov-bar {
  animation: none;
  opacity: 0.55;
}

@keyframes voiceOverlayPulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scaleY(0.65);
  }
  50% {
    opacity: 1;
    transform: scaleY(1);
  }
}

.voice-overlay-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.voice-overlay-sub {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  margin-top: 12rpx;
  text-align: center;
}

.emoji-panel {
  background: #f7f5f4;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  height: 420rpx;
}

.emoji-scroll {
  height: 100%;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 10rpx 24rpx;
}

.emoji-item {
  align-items: center;
  display: flex;
  font-size: 44rpx;
  height: 72rpx;
  justify-content: center;
  width: 12.5%;
}
