page {
  height: 100%;
}

/* 固定一屏；仅此 Tab 页预留底栏，滚动限定在消息与好友列表。 */
.chat-page {
  background: var(--love-bg);
  box-sizing: border-box;
  color: var(--love-text);
  height: 100vh;
  overflow: hidden;
  padding-bottom: calc(var(--love-tab-height) + env(safe-area-inset-bottom));
}

.chat-layout {
  display: flex;
  height: 100%;
  min-height: 0;
  position: relative;
}

.chat-sidebar {
  background: var(--love-surface);
  border-right: 1rpx solid var(--love-border);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  min-height: 0;
  width: 108rpx;
}

.conversation-scroll,
.friends-list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.sidebar-empty {
  color: var(--love-text-muted);
  font-size: 22rpx;
  padding: 32rpx 8rpx;
  text-align: center;
}

.conversation-item {
  align-items: center;
  border-left: 4rpx solid transparent;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 132rpx;
  padding: 20rpx 8rpx 14rpx 4rpx;
}

.conversation-item.active {
  background: var(--love-soft);
  border-left-color: var(--love-primary);
}

.conversation-avatar-wrap {
  position: relative;
}

.conversation-avatar {
  border-radius: var(--love-radius-control);
  display: block;
  height: 64rpx;
  width: 64rpx;
}

.conversation-avatar-fallback,
.friend-avatar-fallback,
.msg-avatar-fallback {
  align-items: center;
  background: var(--love-soft-strong);
  color: var(--love-primary-dark);
  display: flex;
  font-size: 28rpx;
  font-weight: 600;
  justify-content: center;
}

.conversation-name {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 16rpx;
  max-width: 88rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active .conversation-name {
  color: var(--love-primary-dark);
  font-weight: 600;
}

.unread-badge {
  background: var(--love-danger);
  border: 3rpx solid var(--love-surface);
  border-radius: 999rpx;
  box-sizing: border-box;
  color: var(--love-on-primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 28rpx;
  min-width: 34rpx;
  padding: 0 6rpx;
  position: absolute;
  right: -14rpx;
  text-align: center;
  top: -12rpx;
  z-index: 2;
}

.couple-badge {
  background: var(--love-primary);
  border-radius: 6rpx;
  bottom: -10rpx;
  color: var(--love-on-primary);
  font-size: 22rpx;
  left: 50%;
  line-height: 28rpx;
  padding: 0 6rpx;
  position: absolute;
  transform: translateX(-50%);
  white-space: nowrap;
}

.sidebar-friends-btn {
  align-items: center;
  border-top: 1rpx solid var(--love-border);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  justify-content: center;
  min-height: 112rpx;
}

.friends-icon {
  align-items: center;
  display: flex;
  height: 48rpx;
  justify-content: center;
  width: 64rpx;
}

.sidebar-friends-label {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.friends-people {
  height: 36rpx;
  position: relative;
  width: 40rpx;
}

.people-person { position: absolute; }
.people-back { left: 14rpx; opacity: 0.55; top: 0; }
.people-front { left: 0; top: 4rpx; }

.people-head {
  background: var(--love-primary);
  border-radius: 50%;
  height: 14rpx;
  margin: 0 auto;
  width: 14rpx;
}

.people-body {
  background: var(--love-primary);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  height: 14rpx;
  margin: 2rpx auto 0;
  width: 20rpx;
}

.people-back .people-head { height: 12rpx; width: 12rpx; }
.people-back .people-body { height: 12rpx; width: 16rpx; }

/* 好友抽屉覆盖主区域，不挤压消息气泡与输入框。 */
.friends-panel {
  background: var(--love-surface);
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  left: 0;
  padding: 24rpx;
  position: absolute;
  top: 0;
  width: 88%;
  z-index: 50;
}

.friends-panel-head {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.friends-panel-title,
.chat-header-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
}

.friends-panel-close {
  align-items: center;
  color: var(--love-primary);
  display: flex;
  font-size: 26rpx;
  justify-content: center;
  min-height: 80rpx;
  min-width: 88rpx;
}

.friends-search-row { margin-bottom: 16rpx; }

.friends-search,
.friends-add-input {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text);
  font-size: 26rpx;
  height: 84rpx;
  padding: 0 20rpx;
  width: 100%;
}

.friends-add-row {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.friends-add-input { flex: 1; min-width: 0; }

.friends-add-btn,
.friends-group-btn,
.mini-btn {
  align-items: center;
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  display: flex;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 22rpx;
}

.friends-add-btn,
.mini-btn.primary {
  background: var(--love-primary);
  color: var(--love-on-primary);
}

.my-id-line {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
  padding: 22rpx 0;
  word-break: break-all;
}

.friends-group-btn {
  background: var(--love-soft);
  color: var(--love-primary-dark);
  margin-bottom: 24rpx;
}

.friends-list-card { padding-bottom: 12rpx; }
.friends-section { margin-bottom: 28rpx; }

.friends-section-title {
  color: var(--love-text-muted);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  margin: 12rpx 0;
}

.friends-empty {
  color: var(--love-text-muted);
  font-size: 24rpx;
  padding: 40rpx 0;
  text-align: center;
}

.friend-row {
  align-items: center;
  border-bottom: 1rpx solid var(--love-border);
  display: flex;
  gap: 14rpx;
  min-height: 100rpx;
  padding: 14rpx 0;
}

.friend-avatar {
  border-radius: var(--love-radius-control);
  flex-shrink: 0;
  height: 64rpx;
  width: 64rpx;
}

.friend-info { flex: 1; min-width: 0; }

.friend-name {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-sub {
  color: var(--love-text-muted);
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-actions { display: flex; gap: 8rpx; }
.mini-btn { color: var(--love-text-secondary); min-width: 80rpx; padding: 0 14rpx; }
.mini-btn.danger { color: var(--love-danger); }

.friends-dismiss-mask {
  background: var(--love-overlay);
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 40;
}

.chat-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
}

.chat-header {
  background: var(--love-surface);
  border-bottom: 1rpx solid var(--love-border);
  flex-shrink: 0;
  padding: 26rpx 24rpx;
}

.chat-header-title {
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connection-notice {
  background: var(--love-warning-soft);
  color: var(--love-warning);
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 18rpx;
  text-align: center;
}

.message-wrap { flex: 1; height: 0; min-height: 0; }

.message-scroll {
  box-sizing: border-box;
  height: 100%;
  padding: 28rpx 18rpx 12rpx;
}

.message-empty {
  color: var(--love-text-muted);
  font-size: 26rpx;
  line-height: 1.8;
  padding: 96rpx 20rpx;
  text-align: center;
}

.message-row {
  align-items: flex-start;
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.message-row.mine { justify-content: flex-end; }
.message-row.system { justify-content: center; }
.msg-avatar-wrap { flex-shrink: 0; margin-top: 38rpx; }

.msg-avatar {
  border-radius: var(--love-radius-control);
  display: block;
  height: 60rpx;
  width: 60rpx;
}

.msg-avatar-fallback { display: flex; }

.msg-body {
  align-items: flex-start;
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 84rpx);
  min-width: 0;
}

.message-row.mine .msg-body { align-items: flex-end; }

.msg-meta {
  align-items: baseline;
  display: flex;
  gap: 12rpx;
  line-height: 30rpx;
  margin-bottom: 8rpx;
  max-width: 100%;
}

.msg-meta.mine-meta { justify-content: flex-end; }

.msg-name {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  color: var(--love-text-muted);
  flex-shrink: 0;
  font-size: 22rpx;
  white-space: nowrap;
}

.message-bubble {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: 6rpx var(--love-radius-card) var(--love-radius-card);
  box-sizing: border-box;
  color: var(--love-text);
  max-width: 100%;
  padding: 20rpx 22rpx;
}

.message-row.mine .message-bubble {
  background: var(--love-soft);
  border-color: var(--love-soft-strong);
  border-radius: var(--love-radius-card) 6rpx var(--love-radius-card) var(--love-radius-card);
}

.message-bubble.image-bubble {
  background: var(--love-surface-muted);
  overflow: hidden;
  padding: 0;
}

.chat-image {
  display: block;
  height: 320rpx;
  max-width: 100%;
  width: 320rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}

.system-text {
  color: var(--love-text-muted);
  font-size: 22rpx;
  line-height: 1.6;
  max-width: 100%;
  padding: 8rpx 16rpx;
  text-align: center;
  word-break: break-all;
}

.voice-bubble {
  align-items: center;
  display: flex;
  gap: 24rpx;
  min-height: 88rpx;
  min-width: 176rpx;
}

.message-row.mine .voice-bubble { flex-direction: row-reverse; }

.voice-wave,
.voice-overlay-wave {
  align-items: flex-end;
  display: flex;
  gap: 6rpx;
  height: 28rpx;
}

.voice-bar { background: var(--love-primary); border-radius: 4rpx; width: 6rpx; }
.voice-bar:nth-child(1) { height: 12rpx; }
.voice-bar:nth-child(2) { height: 24rpx; }
.voice-bar:nth-child(3) { height: 18rpx; }
.voice-wave.playing .voice-bar { animation: voicePulse 0.9s ease-in-out infinite; }
.voice-wave.playing .voice-bar:nth-child(2) { animation-delay: 0.15s; }
.voice-wave.playing .voice-bar:nth-child(3) { animation-delay: 0.3s; }
.voice-duration { color: var(--love-text-secondary); font-size: 28rpx; }

/* 输入与工具分行，窄屏中为文本保留完整的可用宽度。 */
.composer-wrap {
  background: var(--love-surface);
  border-top: 1rpx solid var(--love-border);
  flex-shrink: 0;
}

.composer { padding: 16rpx 18rpx 8rpx; }
.composer-entry { align-items: center; display: flex; gap: 12rpx; }
.composer-actions { align-items: center; display: flex; gap: 12rpx; margin-top: 4rpx; }

.composer-input,
.voice-hold {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text);
  flex: 1;
  font-size: 28rpx;
  height: 84rpx;
  min-width: 0;
  padding: 0 20rpx;
}

.voice-hold {
  align-items: center;
  display: flex;
  justify-content: center;
  user-select: none;
}

.voice-hold.recording { background: var(--love-soft); color: var(--love-primary-dark); }
.voice-hold.cancel-ready { background: var(--love-danger-soft); color: var(--love-danger); }

.composer-tool {
  align-items: center;
  border-radius: var(--love-radius-control);
  color: var(--love-text-secondary);
  display: flex;
  flex-shrink: 0;
  gap: 10rpx;
  height: 76rpx;
  justify-content: center;
  min-width: 116rpx;
  padding: 0 8rpx;
}

.composer-tool.active { background: var(--love-soft); color: var(--love-primary-dark); }
.composer-tool-label { font-size: 22rpx; }

.tool-glyph {
  background-color: var(--love-primary);
  flex-shrink: 0;
  height: 32rpx;
  mask-position: center;
  mask-repeat: no-repeat;
  mask-size: contain;
  width: 32rpx;
  -webkit-mask-position: center;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: contain;
}

