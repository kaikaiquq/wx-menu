.composer-send {
  align-items: center;
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  display: flex;
  flex-shrink: 0;
  height: 84rpx;
  justify-content: center;
  width: 88rpx;
}

.composer-send.disabled { background: var(--love-soft-strong); }
.composer-send.disabled .tool-glyph { background-color: var(--love-text-muted); }

.emoji-panel {
  background: var(--love-surface-muted);
  border-top: 1rpx solid var(--love-border);
  height: 320rpx;
  max-height: 32vh;
}

.emoji-scroll { height: 100%; }
.emoji-grid { display: flex; flex-wrap: wrap; padding: 12rpx 10rpx 20rpx; }

.emoji-item {
  align-items: center;
  display: flex;
  font-size: 44rpx;
  height: 84rpx;
  justify-content: center;
  width: 14.2857%;
}

.voice-overlay {
  align-items: center;
  background: var(--love-overlay);
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  left: 0;
  padding: 24rpx 24rpx 180rpx;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1100;
}

.voice-overlay-card {
  align-items: center;
  background: var(--love-primary-dark);
  border-radius: var(--love-radius-card);
  box-sizing: border-box;
  color: var(--love-on-primary);
  display: flex;
  flex-direction: column;
  max-width: 100%;
  min-width: 360rpx;
  padding: 40rpx;
}

.voice-overlay.is-cancel .voice-overlay-card { background: var(--love-danger); }
.voice-overlay-mic { display: flex; justify-content: center; margin: 24rpx 0 36rpx; }
.voice-overlay-wave { gap: 10rpx; height: 72rpx; }

.vov-bar {
  animation: voicePulse 0.9s ease-in-out infinite;
  background: var(--love-on-primary);
  border-radius: 6rpx;
  width: 10rpx;
}

.vov-bar:nth-child(1) { height: 28rpx; }
.vov-bar:nth-child(2) { animation-delay: 0.1s; height: 48rpx; }
.vov-bar:nth-child(3) { animation-delay: 0.2s; height: 68rpx; }
.vov-bar:nth-child(4) { animation-delay: 0.15s; height: 40rpx; }
.vov-bar:nth-child(5) { animation-delay: 0.05s; height: 24rpx; }
.voice-overlay.is-cancel .vov-bar { animation: none; }
.voice-overlay-title { font-size: 30rpx; font-weight: 500; text-align: center; }
.voice-overlay-sub { font-size: 24rpx; margin-top: 16rpx; text-align: center; }

@keyframes voicePulse {
  0%, 100% { opacity: 0.5; transform: scaleY(0.65); }
  50% { opacity: 1; transform: scaleY(1); }
}
