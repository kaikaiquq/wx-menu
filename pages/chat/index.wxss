page {
  background: #f4f5f5;
  color: #292421;
  height: 100%;
}

.chat-page {
  background: var(--love-bg, #f4f5f5);
  box-sizing: border-box;
  /* Tab 栏高度 108rpx + 底部安全区 + 约 5px 间隙 */
  height: 100vh;
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom) + 10rpx);
}

.chat-layout {
  display: flex;
  height: 100%;
  position: relative;
}

.chat-sidebar {
  background: #fff;
  border-right: 1rpx solid var(--love-soft-strong, rgba(0, 0, 0, 0.06));
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  transition: width 0.22s ease;
  width: 94rpx;
  z-index: 3;
}

.chat-sidebar.expanded {
  background: var(--love-bg, #f4f5f5);
  width: 50%;
}

.conversation-scroll {
  flex: 1;
  height: 0;
  padding-top: 12rpx;
}

.sidebar-empty {
  color: #a69c96;
  font-size: 18rpx;
  padding: 24rpx 4rpx;
  text-align: center;
}

.conversation-item {
  align-items: center;
  display: flex;
  justify-content: center;
  padding: 12rpx 0;
}

.conversation-item.active {
  background: var(--love-soft, #f7e7e9);
}

.conversation-avatar-wrap {
  position: relative;
}

.conversation-avatar {
  border-radius: 16rpx;
  height: 64rpx;
  width: 64rpx;
}

.conversation-avatar-fallback {
  align-items: center;
  background: var(--love-soft-strong, #f2dcdf);
  color: var(--love-primary-dark, #a95360);
  display: flex;
  font-size: 24rpx;
  font-weight: 600;
  justify-content: center;
}

.unread-badge {
  align-items: center;
  background: #fa5151;
  border: 2rpx solid #fff;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #fff;
  display: flex;
  font-size: 16rpx;
  font-weight: 600;
  height: 28rpx;
  justify-content: center;
  line-height: 1;
  min-width: 28rpx;
  padding: 0 6rpx;
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  z-index: 2;
}

.couple-badge {
  background: var(--love-primary, #bd6875);
  border-radius: 999rpx;
  bottom: -8rpx;
  color: #fff;
  font-size: 14rpx;
  left: 50%;
  padding: 1rpx 6rpx;
  position: absolute;
  transform: translateX(-50%);
  white-space: nowrap;
}

.sidebar-friends-btn {
  align-items: center;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: center;
  padding: 12rpx 0 10rpx;
}

.friends-icon {
  align-items: center;
  background: var(--love-soft, #f7e7e9);
  border-radius: 18rpx;
  display: flex;
  height: 64rpx;
  justify-content: center;
  width: 64rpx;
}

.friends-people {
  height: 36rpx;
  position: relative;
  width: 40rpx;
}

.people-person {
  position: absolute;
}

.people-back {
  left: 14rpx;
  opacity: 0.55;
  top: 0;
}

.people-front {
  left: 0;
  top: 4rpx;
}

.people-head {
  background: var(--love-primary, #bd6875);
  border-radius: 50%;
  height: 14rpx;
  margin: 0 auto;
  width: 14rpx;
}

.people-body {
  background: var(--love-primary, #bd6875);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  height: 14rpx;
  margin: 2rpx auto 0;
  width: 20rpx;
}

.people-back .people-head {
  height: 12rpx;
  width: 12rpx;
}

.people-back .people-body {
  height: 12rpx;
  width: 16rpx;
}

.friends-panel {
  background: var(--love-bg, #f4f5f5);
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 20rpx 18rpx 0;
}

.friends-panel-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.friends-panel-title {
  color: #292421;
  font-size: 28rpx;
  font-weight: 600;
}

.friends-panel-close {
  color: var(--love-primary, #bd6875);
  font-size: 22rpx;
}

.friends-search-row {
  margin-bottom: 14rpx;
}

.friends-search,
.friends-add-input {
  background: #fff;
  border: 1rpx solid var(--love-soft-strong, #f2dcdf);
  border-radius: 16rpx;
  box-sizing: border-box;
  color: #292421;
  font-size: 22rpx;
  height: 68rpx;
  padding: 0 18rpx;
  width: 100%;
}

.friends-add-row {
  align-items: center;
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.friends-add-input {
  flex: 1;
  min-width: 0;
}

.friends-add-btn {
  background: var(--love-primary, #bd6875);
  border-radius: 16rpx;
  color: #fff;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 16rpx 22rpx;
}

.my-id-line {
  color: var(--love-primary-dark, #a95360);
  font-size: 18rpx;
  line-height: 1.4;
  margin-bottom: 14rpx;
  opacity: 0.85;
  overflow: hidden;
  padding: 0 4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friends-group-btn {
  background: var(--love-soft, #f7e7e9);
  border: 1rpx solid var(--love-soft-strong, #f2dcdf);
  border-radius: 16rpx;
  color: var(--love-primary-dark, #a95360);
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.friends-list-scroll {
  flex: 1;
  height: 0;
  padding-bottom: 20rpx;
}

.friends-list-card {
  background: var(--love-soft, #f7e7e9);
  border-radius: 20rpx;
  box-sizing: border-box;
  min-height: 100%;
  padding: 16rpx 14rpx 20rpx;
}

.friends-section + .friends-section-title,
.friends-section {
  margin-bottom: 8rpx;
}

.friends-section-title {
  color: var(--love-primary-dark, #a95360);
  font-size: 18rpx;
  font-weight: 600;
  margin: 6rpx 4rpx 12rpx;
  opacity: 0.9;
}

.friends-empty {
  color: var(--love-primary-dark, #a95360);
  font-size: 22rpx;
  opacity: 0.7;
  padding: 36rpx 0;
  text-align: center;
}

.friend-row {
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
  padding: 14rpx 12rpx;
}

.friend-avatar {
  border-radius: 14rpx;
  flex-shrink: 0;
  height: 56rpx;
  width: 56rpx;
}

.friend-avatar-fallback {
  align-items: center;
  background: var(--love-soft-strong, #f2dcdf);
  color: var(--love-primary, #bd6875);
  display: flex;
  font-size: 22rpx;
  justify-content: center;
}

.friend-info {
  flex: 1;
  min-width: 0;
}

.friend-name {
  color: #292421;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-sub {
  color: #8f8680;
  font-size: 16rpx;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-actions {
  display: flex;
  gap: 8rpx;
}

.mini-btn {
  border: 1rpx solid var(--love-primary, #bd6875);
  border-radius: 999rpx;
  color: var(--love-primary, #bd6875);
  font-size: 18rpx;
  padding: 8rpx 14rpx;
}

.mini-btn.primary {
  background: var(--love-primary, #bd6875);
  border-color: transparent;
  color: #fff;
}

.mini-btn.danger {
  border-color: transparent;
  color: var(--love-primary-dark, #a95360);
  opacity: 0.85;
}

/* 男生主题微调：侧栏展开阴影更冷色 */
.theme-male .chat-sidebar.expanded {
  box-shadow: 8rpx 0 28rpx rgba(74, 96, 114, 0.12);
}

.theme-male .friends-dismiss-mask {
  background: rgba(45, 58, 70, 0.18);
}

.theme-female .chat-sidebar.expanded {
  box-shadow: 8rpx 0 28rpx rgba(140, 74, 86, 0.1);
}

.theme-female .friends-dismiss-mask {
  background: rgba(75, 45, 50, 0.16);
}

.chat-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  position: relative;
}

.message-wrap {
  flex: 1;
  height: 0;
  position: relative;
}

.friends-dismiss-mask {
  background: rgba(41, 36, 33, 0.18);
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 2;
}

.chat-header {
  background: rgba(255, 255, 255, 0.9);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 24rpx 24rpx 18rpx;
}

.chat-header-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 600;
}

.message-scroll {
  box-sizing: border-box;
  height: 100%;
  padding: 24rpx 22rpx;
}

.message-empty {
  color: #a69c96;
  font-size: 22rpx;
  padding: 80rpx 20rpx;
  text-align: center;
}

.message-row {
  align-items: flex-start;
  display: flex;
  gap: 14rpx;
  justify-content: flex-start;
  margin-bottom: 22rpx;
  margin-top: 28rpx;
}

.message-row.mine {
  justify-content: flex-end;
}

.message-row.system {
  justify-content: center;
  margin-top: 8rpx;
}

.msg-avatar-wrap {
  flex-shrink: 0;
}

.msg-avatar {
  border-radius: 12rpx;
  height: 72rpx;
  width: 72rpx;
}

.msg-avatar-fallback {
  align-items: center;
  background: var(--love-soft-strong, #f2dcdf);
  color: var(--love-primary-dark, #a95360);
  display: flex;
  font-size: 26rpx;
  font-weight: 600;
  justify-content: center;
}

.msg-body {
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 100rpx);
  min-width: 0;
  position: relative;
}

.message-row.mine .msg-body {
  align-items: flex-end;
}

.msg-meta {
  align-items: baseline;
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  left: 4rpx;
  position: absolute;
  top: -28rpx;
  white-space: nowrap;
  width: max-content;
}

.msg-meta.mine-meta {
  justify-content: flex-end;
  left: auto;
  right: 4rpx;
}

.msg-name {
  color: #8f8680;
  flex-shrink: 1;
  font-size: 20rpx;
  font-weight: 500;
  max-width: 220rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  color: #b5ada8;
  flex-shrink: 0;
  font-size: 18rpx;
  white-space: nowrap;
}

.message-bubble {
  background: #fff;
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(75, 59, 53, 0.05);
  box-sizing: border-box;
  max-width: 100%;
  padding: 18rpx 22rpx;
}

.message-row.mine .message-bubble {
  background: var(--love-soft-strong, #f2dcdf);
  border-radius: 22rpx 6rpx 22rpx 22rpx;
}

.message-bubble.image-bubble {
  background: rgba(0, 0, 0, 0.03);
  box-shadow: none;
  overflow: hidden;
  padding: 0;
}

.message-row.mine .message-bubble.image-bubble {
  background: rgba(0, 0, 0, 0.03);
}

.chat-image {
  border-radius: 12rpx;
  display: block;
  height: 360rpx;
  max-width: 360rpx;
  width: 360rpx;
}

.message-text {
  color: #292421;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.system-text {
  background: rgba(0, 0, 0, 0.04);
  border-radius: 999rpx;
  color: #8f8680;
  font-size: 18rpx;
  padding: 8rpx 16rpx;
}

.voice-bubble {
  align-items: center;
  display: flex;
  gap: 16rpx;
  min-width: 140rpx;
  padding: 20rpx 24rpx;
}

.message-row.mine .voice-bubble {
  flex-direction: row-reverse;
}

.voice-wave {
  align-items: flex-end;
  display: flex;
  gap: 6rpx;
  height: 28rpx;
}

.voice-bar {
  background: var(--love-primary, #bd6875);
  border-radius: 4rpx;
  width: 6rpx;
}

.voice-bar:nth-child(1) {
  height: 12rpx;
}

.voice-bar:nth-child(2) {
  height: 22rpx;
}

.voice-bar:nth-child(3) {
  height: 16rpx;
}

.voice-wave.playing .voice-bar {
  animation: voicePulse 0.9s ease-in-out infinite;
}

.voice-wave.playing .voice-bar:nth-child(2) {
  animation-delay: 0.15s;
}

.voice-wave.playing .voice-bar:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes voicePulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scaleY(0.7);
  }
  50% {
    opacity: 1;
    transform: scaleY(1);
  }
}

.voice-duration {
  color: #5c5550;
  font-size: 24rpx;
  font-weight: 500;
}

.composer-wrap {
  background: #fff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.composer {
  align-items: center;
  display: flex;
  gap: 10rpx;
  padding: 10rpx 12rpx 8rpx;
}

.composer-tool {
  align-items: center;
  background: var(--love-soft, #f6f3f1);
  border-radius: 14rpx;
  display: flex;
  flex-shrink: 0;
  height: 60rpx;
  justify-content: center;
  width: 60rpx;
}

.composer-tool.active {
  background: var(--love-soft-strong, #f2dcdf);
}

.tool-glyph {
  background-color: var(--love-primary, #bd6875);
  flex-shrink: 0;
  height: 34rpx;
  mask-position: center;
  mask-repeat: no-repeat;
  mask-size: contain;
  width: 34rpx;
  -webkit-mask-position: center;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: contain;
}

