page {
  background: #f8f5f2;
  color: #292421;
  padding-bottom: calc(env(safe-area-inset-bottom) + 130rpx);
}

.space-page {
  background: var(--love-bg, #f8f5f2);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx;
}

.space-hero {
  align-items: center;
  background: linear-gradient(145deg, #342e2b, #211d1b);
  border-radius: 38rpx;
  box-shadow: 0 22rpx 50rpx rgba(48, 37, 33, 0.2);
  color: #fff;
  display: flex;
  flex-direction: column;
  padding: 42rpx 34rpx 44rpx;
}

.space-eyebrow {
  color: var(--love-soft-strong, #d7b2b7);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.couple-row {
  align-items: center;
  display: flex;
  margin-top: 38rpx;
}

.person {
  align-items: center;
  display: flex;
  flex-direction: column;
}

.person-avatar {
  align-items: center;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  display: flex;
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 30rpx;
  height: 112rpx;
  justify-content: center;
  width: 112rpx;
}

.person-avatar-her {
  background: var(--love-primary, #e4a1ab);
}

.person-avatar-him {
  background: #837772;
}

.person-name {
  font-size: 20rpx;
  margin-top: 13rpx;
  opacity: 0.85;
}

.love-mark {
  align-items: center;
  display: flex;
  margin: 0 22rpx 32rpx;
}

.love-line {
  background: rgba(255, 255, 255, 0.22);
  height: 1rpx;
  width: 28rpx;
}

.love-heart {
  color: var(--love-primary, #e9a9b2);
  font-size: 42rpx;
  margin: 0 10rpx;
}

.together-text {
  font-size: 20rpx;
  margin-top: 28rpx;
  opacity: 0.6;
}

.together-days {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 64rpx;
  font-weight: 600;
  margin-top: 5rpx;
}

.together-days text {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 8rpx;
}

.anniversary-pill {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 30rpx;
  color: #d5ccc8;
  font-size: 19rpx;
  margin-top: 18rpx;
  padding: 10rpx 22rpx;
}

.stats-row {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 22rpx;
}

.stats-row-single {
  grid-template-columns: 1fr;
}

.stat-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(75, 59, 53, 0.05);
  padding: 25rpx 8rpx;
  text-align: center;
}

.stat-value {
  color: var(--love-primary, #b96270);
  font-size: 31rpx;
  font-weight: 600;
}

.stat-label {
  color: #9f9690;
  font-size: 19rpx;
  margin-top: 7rpx;
}

.section-heading {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  margin: 50rpx 4rpx 22rpx;
}

.section-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 35rpx;
  font-weight: 600;
}

.section-subtitle {
  color: #a79d97;
  font-size: 20rpx;
  margin-top: 6rpx;
}

.latest-card,
.latest-empty {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 35rpx rgba(75, 59, 53, 0.06);
  padding: 28rpx;
}

.latest-top {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.latest-date {
  color: #a69c96;
  font-size: 20rpx;
}

.latest-status {
  background: var(--love-soft, #f7e8ea);
  border-radius: 18rpx;
  color: var(--love-primary, #b95f6d);
  font-size: 18rpx;
  padding: 7rpx 14rpx;
}

.latest-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 18rpx;
}

.latest-note {
  border-left: 4rpx solid var(--love-primary, #dda0a9);
  color: #9d938e;
  font-size: 21rpx;
  margin-top: 14rpx;
  padding-left: 14rpx;
}

.latest-avatars {
  display: flex;
  margin-top: 22rpx;
}

.latest-image {
  border: 4rpx solid #fff;
  border-radius: 50%;
  height: 62rpx;
  margin-left: -12rpx;
  width: 62rpx;
}

.latest-image:first-child {
  margin-left: 0;
}

.latest-empty {
  align-items: center;
  color: #8f8580;
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  padding: 42rpx;
}

.latest-empty-icon {
  color: var(--love-primary, #ce7b87);
  font-size: 55rpx;
  margin-bottom: 8rpx;
}

.latest-empty-button {
  border: 1rpx solid #2c2724;
  border-radius: 28rpx;
  color: #2c2724;
  margin-top: 22rpx;
  padding: 13rpx 28rpx;
}

.tool-grid {
  display: grid;
  gap: 18rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.tool-card {
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(75, 59, 53, 0.05);
  padding: 25rpx;
}

.tool-card-admin {
  border: 1rpx solid rgba(44, 39, 36, 0.08);
  grid-column: 1 / -1;
}

.tool-card-invite {
  background: var(--love-soft, #f7e7e9);
  grid-column: 1 / -1;
}

.tool-icon {
  align-items: center;
  border-radius: 18rpx;
  display: flex;
  font-size: 31rpx;
  height: 64rpx;
  justify-content: center;
  width: 64rpx;
}

.tool-icon-pink {
  background: var(--love-soft, #f6e4e7);
}

.tool-icon-yellow {
  background: #f5edd8;
}

.tool-icon-blue {
  background: #e5edf3;
}

.tool-icon-green {
  background: #e4efe8;
}

.tool-icon-dark {
  background: #292421;
}

.tool-icon-invite {
  background: #fff;
}

.tool-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 18rpx;
}

.tool-note {
  color: #a69c96;
  font-size: 19rpx;
  margin-top: 7rpx;
}
