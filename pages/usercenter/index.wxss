.space-page {
  background: var(--love-bg);
  box-sizing: border-box;
  color: var(--love-text);
  min-height: 100vh;
  padding: 40rpx var(--love-page-gutter) calc(var(--love-tab-height) + 40rpx + env(safe-area-inset-bottom));
}

.space-heading {
  padding: 8rpx 0 32rpx;
}

.space-eyebrow {
  color: var(--love-primary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.space-title {
  font-family: var(--love-heading-font);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.35;
  margin-top: 12rpx;
}

.space-caption {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.space-hero {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  overflow: hidden;
  padding: 36rpx 28rpx 32rpx;
  text-align: center;
}

.couple-row {
  align-items: center;
  display: flex;
  justify-content: center;
}

.person {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  max-width: 220rpx;
  min-width: 0;
}

.person-avatar {
  background: var(--love-soft);
  border: 6rpx solid var(--love-surface);
  border-radius: 50%;
  box-sizing: border-box;
  height: 116rpx;
  width: 116rpx;
}

.person-avatar-fallback {
  align-items: center;
  color: var(--love-primary);
  display: flex;
  font-family: var(--love-heading-font);
  font-size: 36rpx;
  justify-content: center;
}

.person-avatar-peer {
  background: var(--love-surface-muted);
  color: var(--love-text-secondary);
}

.person-name {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 12rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.love-mark {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  justify-content: center;
  margin: 0 12rpx 48rpx;
  width: 100rpx;
}

.love-mark::before,
.love-mark::after {
  background: var(--love-border);
  content: '';
  flex: 1;
  height: 1rpx;
}

.love-ring {
  color: var(--love-primary);
  font-size: 32rpx;
  line-height: 1;
  padding: 0 10rpx;
}

.anniversary-block {
  border-top: 1rpx solid var(--love-border);
  margin-top: 28rpx;
  padding-top: 28rpx;
  text-align: center;
}

.together-text {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.together-days {
  color: var(--love-primary-dark);
  font-family: var(--love-heading-font);
  font-size: 96rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.2;
  margin-top: 12rpx;
}

.together-days text {
  color: var(--love-text-secondary);
  font-size: 26rpx;
  font-weight: 400;
  margin-left: 12rpx;
}

.hero-meta {
  color: var(--love-text-secondary);
  display: inline-block;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
}

.hero-meta-link {
  color: var(--love-primary);
}

.section {
  margin-top: 44rpx;
}

.section-head {
  align-items: center;
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  font-family: var(--love-heading-font);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.section-subtitle {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.section-more {
  color: var(--love-primary);
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 16rpx 0 16rpx 16rpx;
}

.latest-card,
.latest-empty,
.tool-list {
  background: var(--love-surface);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
}

.latest-card {
  padding: 28rpx;
}

.latest-top {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.latest-date {
  color: var(--love-text-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.latest-status {
  background: var(--love-soft);
  border-radius: 8rpx;
  color: var(--love-primary-dark);
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 6rpx 12rpx;
}

.latest-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.6;
  margin-top: 20rpx;
  word-break: break-all;
}

.latest-note {
  border-left: 3rpx solid var(--love-primary);
  color: var(--love-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 18rpx;
  padding-left: 18rpx;
  word-break: break-all;
}

.latest-response {
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  color: var(--love-primary-dark);
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 20rpx;
  padding: 20rpx;
  word-break: break-all;
}

.latest-hint {
  border-top: 1rpx solid var(--love-border);
  color: var(--love-text-muted);
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.latest-thumbs {
  margin-top: 24rpx;
  white-space: nowrap;
  width: 100%;
}

.latest-image {
  border-radius: var(--love-radius-control);
  display: inline-block;
  height: 104rpx;
  margin-right: 14rpx;
  vertical-align: top;
  width: 104rpx;
}

.latest-empty {
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 48rpx 28rpx;
}

.latest-empty-icon {
  color: var(--love-primary);
  font-size: 54rpx;
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.latest-empty-title {
  color: var(--love-text-secondary);
  font-size: 28rpx;
}

.latest-empty-button {
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 28rpx;
  padding: 22rpx 32rpx;
}

.tool-list {
  overflow: hidden;
  padding: 0 26rpx;
}

.tool-row {
  align-items: center;
  border-top: 1rpx solid var(--love-border);
  display: flex;
  gap: 20rpx;
  padding: 26rpx 0;
}

.tool-list > .tool-row:first-child {
  border-top: 0;
}

.tool-icon {
  align-items: center;
  background: var(--love-soft);
  border-radius: var(--love-radius-control);
  color: var(--love-primary);
  display: flex;
  flex-shrink: 0;
  font-size: 28rpx;
  height: 68rpx;
  justify-content: center;
  width: 68rpx;
}

.tool-icon-muted {
  background: var(--love-surface-muted);
  color: var(--love-text-secondary);
}

.tool-copy {
  flex: 1;
  min-width: 0;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.tool-note {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 6rpx;
  word-break: break-all;
}

.tool-arrow {
  color: var(--love-text-muted);
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1;
}

.tool-grid {
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-card);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 20rpx;
  overflow: hidden;
}

.tool-tile {
  border-left: 1rpx solid var(--love-border);
  padding: 26rpx 18rpx;
}

.tool-tile:first-child {
  border-left: 0;
}

.tool-tile-name {
  color: var(--love-primary-dark);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.tool-tile-note {
  color: var(--love-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.profile-mask {
  align-items: flex-end;
  background: var(--love-overlay);
  bottom: 0;
  display: flex;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}

.history-sheet,
.profile-sheet {
  background: var(--love-surface);
  border-radius: var(--love-radius-card) var(--love-radius-card) 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-height: 88vh;
  overflow: hidden;
  padding: 18rpx var(--love-page-gutter) calc(24rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.profile-sheet-handle {
  background: var(--love-border);
  border-radius: 8rpx;
  flex-shrink: 0;
  height: 6rpx;
  margin: 0 auto 30rpx;
  width: 56rpx;
}

.profile-sheet-title {
  flex-shrink: 0;
  font-family: var(--love-heading-font);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.history-list,
.detail-scroll {
  flex-shrink: 1;
  height: 52vh;
  margin-top: 28rpx;
  min-height: 0;
}

.history-card {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.history-card:last-child {
  margin-bottom: 0;
}

.detail-items {
  margin-top: 24rpx;
}

.detail-item {
  align-items: flex-start;
  border-top: 1rpx solid var(--love-border);
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  padding: 20rpx 0;
}

.detail-item-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  min-width: 0;
  word-break: break-all;
}

.detail-item-meta {
  color: var(--love-text-secondary);
  flex: 0 1 45%;
  font-size: 24rpx;
  line-height: 1.65;
  text-align: right;
  word-break: break-all;
}

.history-close {
  background: var(--love-primary);
  border-radius: var(--love-radius-control);
  color: var(--love-on-primary);
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 24rpx;
  padding: 24rpx;
  text-align: center;
}

.profile-editor-scroll {
  flex-shrink: 1;
  height: 560rpx;
  max-height: 64vh;
  min-height: 0;
}

.profile-avatar-button {
  background: transparent;
  border-radius: 50%;
  display: block;
  height: 112rpx;
  margin: 28rpx auto 24rpx;
  padding: 0;
  width: 112rpx;
}

.profile-avatar-button::after {
  border: 0;
}

.profile-avatar {
  border-radius: 50%;
  height: 112rpx;
  width: 112rpx;
}

.profile-avatar-empty {
  align-items: center;
  background: var(--love-soft);
  color: var(--love-primary);
  display: flex;
  font-size: 42rpx;
  justify-content: center;
}

.profile-nickname-input {
  background: var(--love-surface-muted);
  border: 1rpx solid var(--love-border);
  border-radius: var(--love-radius-control);
  box-sizing: border-box;
  color: var(--love-text);
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  text-align: center;
  width: 100%;
}

.profile-sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.profile-cancel,
.profile-save {
  border-radius: var(--love-radius-control);
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  padding: 24rpx 0;
  text-align: center;
}

.profile-cancel {
  background: var(--love-surface-muted);
  color: var(--love-text-secondary);
}

.profile-save {
  background: var(--love-primary);
  color: var(--love-on-primary);
}

.profile-save-disabled {
  opacity: 0.55;
}

.profile-logout {
  color: var(--love-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
  padding: 24rpx 0;
  text-align: center;
}
