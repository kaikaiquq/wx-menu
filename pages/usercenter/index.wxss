page {
  background: #f4f5f5;
  color: #2a2624;
  padding-bottom: calc(env(safe-area-inset-bottom) + 130rpx);
}

.space-page {
  background: var(--love-bg, #f4f5f5);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
}

/* —— 顶部关系卡 —— */
.space-hero {
  background: linear-gradient(160deg, var(--love-hero-from), var(--love-hero-to));
  border-radius: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(80, 60, 55, 0.14);
  color: #fff;
  overflow: hidden;
  padding: 32rpx 28rpx 28rpx;
  position: relative;
}

.hero-glow {
  background: radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.28), transparent 55%);
  height: 220rpx;
  left: 0;
  pointer-events: none;
  position: absolute;
  right: 0;
  top: 0;
}

.couple-row {
  align-items: center;
  display: flex;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.person {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  max-width: 220rpx;
}

.person-avatar {
  background: rgba(255, 255, 255, 0.22);
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.12);
  height: 108rpx;
  width: 108rpx;
}

.person-avatar-fallback {
  align-items: center;
  color: #fff;
  display: flex;
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 34rpx;
  justify-content: center;
}

.person-avatar-peer {
  background: rgba(255, 255, 255, 0.16);
}

.person-name {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 12rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.love-mark {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  justify-content: center;
  margin: 0 8rpx 28rpx;
  width: 72rpx;
}

.love-ring {
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 50%;
  display: flex;
  font-size: 28rpx;
  height: 56rpx;
  justify-content: center;
  width: 56rpx;
}

.anniversary-block {
  margin-top: 22rpx;
  position: relative;
  text-align: center;
  z-index: 1;
}

.together-text {
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
  opacity: 0.9;
}

.together-days {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.05;
  margin-top: 6rpx;
}

.together-days text {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 6rpx;
}

.hero-meta {
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  display: inline-block;
  font-size: 20rpx;
  left: 50%;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  position: relative;
  transform: translateX(-50%);
  z-index: 1;
}

.hero-meta-link {
  text-decoration: underline;
  text-decoration-color: rgba(255, 255, 255, 0.45);
  text-underline-offset: 6rpx;
}

/* —— 分区 —— */
.section {
  margin-top: 28rpx;
}

.section-head {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  margin: 0 6rpx 16rpx;
}

.section-title {
  color: #2a2624;
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 600;
}

.section-subtitle {
  color: #9a918b;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.section-more {
  color: var(--love-primary, #bd6875);
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 8rpx 0;
}

/* —— 已完成心愿 —— */
.latest-card,
.latest-empty {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(70, 55, 50, 0.05);
  padding: 24rpx;
}

.latest-top {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.latest-date {
  color: #9a918b;
  font-size: 20rpx;
}

.latest-status {
  background: var(--love-soft, #f7e8ea);
  border-radius: 999rpx;
  color: var(--love-primary-dark, #a95360);
  font-size: 18rpx;
  padding: 6rpx 14rpx;
}

.latest-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-top: 14rpx;
}

.latest-note {
  border-left: 4rpx solid var(--love-primary, #bd6875);
  color: #8f8680;
  font-size: 22rpx;
  margin-top: 12rpx;
  padding-left: 14rpx;
}

.latest-response {
  background: var(--love-soft, #f7e8ea);
  border-radius: 16rpx;
  color: var(--love-primary-dark, #a95360);
  font-size: 20rpx;
  line-height: 1.5;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
}

.latest-hint {
  color: #c0b6b0;
  font-size: 18rpx;
  margin-top: 16rpx;
  text-align: right;
}

.latest-thumbs {
  margin-top: 18rpx;
  white-space: nowrap;
  width: 100%;
}

.latest-image {
  border-radius: 16rpx;
  display: inline-block;
  height: 88rpx;
  margin-right: 12rpx;
  vertical-align: top;
  width: 88rpx;
}

.latest-empty {
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 40rpx 28rpx;
}

.latest-empty-icon {
  color: var(--love-primary, #bd6875);
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.latest-empty-title {
  color: #8f8680;
  font-size: 24rpx;
}

.latest-empty-button {
  background: var(--love-primary, #bd6875);
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  margin-top: 20rpx;
  padding: 14rpx 28rpx;
}

/* —— 工具箱 —— */
.tool-list {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(70, 55, 50, 0.05);
  overflow: hidden;
}

.tool-row {
  align-items: center;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  gap: 16rpx;
  padding: 22rpx 20rpx;
}

.tool-row:first-child {
  border-top: 0;
}

.tool-row-primary {
  background: var(--love-soft, #f7e7e9);
}

.tool-icon {
  align-items: center;
  background: var(--love-primary, #bd6875);
  border-radius: 16rpx;
  color: #fff;
  display: flex;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  height: 56rpx;
  justify-content: center;
  width: 56rpx;
}

.tool-icon-muted {
  background: var(--love-soft-strong, #f2dcdf);
  color: var(--love-primary-dark, #a95360);
}

.tool-copy {
  flex: 1;
  min-width: 0;
}

.tool-name {
  font-size: 26rpx;
  font-weight: 600;
}

.tool-note {
  color: #9a918b;
  font-size: 20rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-arrow {
  color: #c4bbb5;
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
}

.tool-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 14rpx;
}

.tool-tile {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(70, 55, 50, 0.04);
  padding: 22rpx 16rpx;
}

.tool-tile-name {
  color: var(--love-primary-dark, #a95360);
  font-size: 24rpx;
  font-weight: 600;
}

.tool-tile-note {
  color: #9a918b;
  font-size: 18rpx;
  margin-top: 8rpx;
}

/* —— 历史心愿弹层 —— */
.history-sheet {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  left: 0;
  max-height: 72vh;
  padding: 18rpx 28rpx 24rpx;
  position: absolute;
  right: 0;
  width: 100%;
}

.history-list {
  flex: 1;
  margin-top: 18rpx;
  max-height: 52vh;
  min-height: 240rpx;
}

.history-card {
  background: #f8f6f4;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
  padding: 20rpx;
}

.history-card:last-child {
  margin-bottom: 0;
}

.history-sheet-detail {
  max-height: 70vh;
}

.detail-card {
  margin-top: 18rpx;
}

.detail-items {
  margin-top: 16rpx;
}

.detail-item {
  align-items: center;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}

.detail-item:first-child {
  border-top: 0;
}

.detail-item-name {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  min-width: 0;
  padding-right: 16rpx;
}

.detail-item-meta {
  color: #9a918b;
  flex-shrink: 0;
  font-size: 20rpx;
}

.history-close {
  background: var(--love-primary, #bd6875);
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 18rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* —— 资料弹层 —— */
.profile-mask {
  align-items: flex-end;
  background: rgba(30, 24, 22, 0.45);
  bottom: 0;
  display: flex;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}

.profile-sheet {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  left: 0;
  padding: 18rpx 36rpx 28rpx;
  position: absolute;
  right: 0;
  width: 100%;
}

.profile-sheet-handle {
  background: #e4ddda;
  border-radius: 8rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  width: 64rpx;
}

.profile-sheet-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.profile-avatar-button {
  background: transparent;
  display: block;
  height: 112rpx;
  margin: 22rpx auto 18rpx;
  padding: 0;
  width: 112rpx;
}

.profile-avatar-button::after {
  border: 0;
}

.profile-avatar {
  border-radius: 50%;
  height: 112rpx;
  width: 112rpx;
}

.profile-avatar-empty {
  align-items: center;
  background: var(--love-soft, #f3e5e7);
  color: var(--love-primary, #bd6875);
  display: flex;
  font-size: 42rpx;
  justify-content: center;
}

.profile-nickname-input {
  background: var(--love-soft, #f8f5f2);
  border-radius: 20rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  text-align: center;
  width: 100%;
}

.profile-sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.profile-cancel,
.profile-save {
  border-radius: 24rpx;
  flex: 1;
  font-size: 25rpx;
  padding: 18rpx 0;
  text-align: center;
}

.profile-cancel {
  background: #f3efec;
  color: #6f6762;
}

.profile-save {
  background: var(--love-primary, #bd6875);
  color: #fff;
}

.profile-save-disabled {
  opacity: 0.6;
}

.profile-logout {
  color: #a79d97;
  font-size: 23rpx;
  margin-top: 18rpx;
  padding: 8rpx 0 4rpx;
  text-align: center;
}

/* —— 女生主题微调 —— */
.theme-female .space-hero {
  box-shadow: 0 18rpx 42rpx rgba(168, 80, 96, 0.22);
}

.theme-female .tool-row-primary {
  background: linear-gradient(90deg, #f8eaec, #f7e7e9);
}

.theme-female .tool-tile-name {
  color: #a95360;
}

/* —— 男生主题微调 —— */
.theme-male .space-hero {
  box-shadow: 0 18rpx 42rpx rgba(70, 95, 115, 0.2);
}

.theme-male .tool-row-primary {
  background: linear-gradient(90deg, #e8eef3, #e2eaf0);
}

.theme-male .tool-tile-name {
  color: #4d687e;
}

.theme-male .latest-empty-button,
.theme-male .profile-save,
.theme-male .tool-icon {
  background: var(--love-primary, #647e94);
}

.theme-male .profile-cancel {
  background: #e8eef2;
  color: #5a6a78;
}
