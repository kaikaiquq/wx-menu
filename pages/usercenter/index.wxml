<view class="space-page {{themeClass}}">
  <view class="space-hero">
    <view class="hero-glow"></view>
    <view class="couple-row">
      <view
        class="person"
        data-public-id="{{displayMembers[0].publicUserId}}"
        bind:tap="handleAvatarTap"
      >
        <image
          class="person-avatar"
          wx:if="{{displayMembers[0].avatarUrl}}"
          src="{{displayMembers[0].avatarUrl}}"
          mode="aspectFill"
        />
        <view class="person-avatar person-avatar-fallback" wx:else>
          {{displayMembers[0].fallbackLabel}}
        </view>
        <view class="person-name">{{displayMembers[0].nickname}}</view>
      </view>

      <view class="love-mark">
        <view class="love-ring">♡</view>
      </view>

      <view
        class="person"
        data-public-id="{{displayMembers[1].publicUserId}}"
        bind:tap="handleAvatarTap"
      >
        <image
          class="person-avatar"
          wx:if="{{displayMembers[1].avatarUrl}}"
          src="{{displayMembers[1].avatarUrl}}"
          mode="aspectFill"
        />
        <view class="person-avatar person-avatar-fallback person-avatar-peer" wx:else>
          {{displayMembers[1].fallbackLabel}}
        </view>
        <view class="person-name">{{displayMembers[1].nickname}}</view>
      </view>
    </view>

    <block wx:if="{{coupleStatus === 'active'}}">
      <picker
        mode="date"
        value="{{profile.anniversary}}"
        end="{{maxDate}}"
        bindchange="changeAnniversary"
      >
        <view class="anniversary-block">
          <view class="together-text">自 {{profile.anniversaryText || '某一天'}} 起在一起的第</view>
          <view class="together-days">{{coupleDays}}<text>天</text></view>
        </view>
      </picker>
      <view class="hero-meta {{historyOrders.length ? 'hero-meta-link' : ''}}" bind:tap="openHistorySheet">
        一起点单 {{orderCount}} 次
      </view>
    </block>
    <view class="anniversary-block" wx:else>
      <view class="together-text">尚未绑定伴侣</view>
      <view class="hero-meta {{historyOrders.length ? 'hero-meta-link' : ''}}" bind:tap="openHistorySheet">
        个人记录 {{orderCount}} 条
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">已完成的心愿</view>
        <view class="section-subtitle">认真记录每一次选择</view>
      </view>
      <view class="section-more" wx:if="{{historyOrders.length}}" bind:tap="openHistorySheet">全部 ›</view>
    </view>

    <view class="latest-card" wx:if="{{latestOrder}}" bind:tap="openHistorySheet">
      <view class="latest-top">
        <view class="latest-date">{{latestOrder.dateText}}</view>
        <view class="latest-status">{{latestOrder.status}}</view>
      </view>
      <view class="latest-title">{{latestOrder.itemNames}}</view>
      <view class="latest-note" wx:if="{{latestOrder.note}}">“{{latestOrder.note}}”</view>
      <view class="latest-response" wx:if="{{latestOrder.responseText}}">{{latestOrder.responseText}}</view>
      <scroll-view class="latest-thumbs" scroll-x wx:if="{{latestOrder.items.length}}">
        <image
          class="latest-image"
          wx:for="{{latestOrder.items}}"
          wx:key="menuItemId"
          wx:for-item="orderItem"
          src="{{orderItem.image}}"
          mode="aspectFill"
        />
      </scroll-view>
      <view class="latest-hint">点击查看全部历史心愿</view>
    </view>

    <view class="latest-empty" wx:else>
      <view class="latest-empty-icon">♡</view>
      <view class="latest-empty-title">还没有共同心愿</view>
      <view class="latest-empty-button" bind:tap="goMenu">
        {{coupleStatus === 'none' ? '管理我的内容' : '去点第一单'}}
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">情侣工具箱</view>
    </view>

    <view class="tool-list">
      <view class="tool-row tool-row-primary" wx:if="{{coupleStatus !== 'active'}}" bind:tap="openInvite">
        <view class="tool-icon">＋</view>
        <view class="tool-copy">
          <view class="tool-name">绑定情侣空间</view>
          <view class="tool-note">分享邀请，或输入 TA 的邀请码</view>
        </view>
        <view class="tool-arrow">›</view>
      </view>

      <view class="tool-row tool-row-primary" wx:if="{{coupleStatus === 'active'}}" bind:tap="openAdmin">
        <view class="tool-icon">♡</view>
        <view class="tool-copy">
          <view class="tool-name">共同空间管理</view>
          <view class="tool-note">导入彼此喜欢的点单内容</view>
        </view>
        <view class="tool-arrow">›</view>
      </view>

      <view class="tool-row" bind:tap="openPersonalLibrary">
        <view class="tool-icon tool-icon-muted">库</view>
        <view class="tool-copy">
          <view class="tool-name">我的内容库</view>
          <view class="tool-note">管理只属于自己的喜好</view>
        </view>
        <view class="tool-arrow">›</view>
      </view>

      <picker
        wx:if="{{coupleStatus === 'active'}}"
        mode="date"
        value="{{profile.anniversary}}"
        end="{{maxDate}}"
        bindchange="changeAnniversary"
      >
        <view class="tool-row">
          <view class="tool-icon tool-icon-muted">日</view>
          <view class="tool-copy">
            <view class="tool-name">纪念日</view>
            <view class="tool-note">{{profile.anniversaryText || '点击设置在一起的日子'}}</view>
          </view>
          <view class="tool-arrow">›</view>
        </view>
      </picker>

      <view class="tool-row" wx:else bind:tap="showComingSoon">
        <view class="tool-icon tool-icon-muted">日</view>
        <view class="tool-copy">
          <view class="tool-name">纪念日</view>
          <view class="tool-note">绑定后可设置</view>
        </view>
        <view class="tool-arrow">›</view>
      </view>
    </view>

    <view class="tool-grid">
      <view class="tool-tile" bind:tap="showComingSoon">
        <view class="tool-tile-name">随机约会</view>
        <view class="tool-tile-note">选择困难交给它</view>
      </view>
      <view class="tool-tile" bind:tap="showComingSoon">
        <view class="tool-tile-name">悄悄话</view>
        <view class="tool-tile-note">写给彼此的小信</view>
      </view>
      <view class="tool-tile" bind:tap="showComingSoon">
        <view class="tool-tile-name">回忆册</view>
        <view class="tool-tile-note">收藏喜欢的瞬间</view>
      </view>
    </view>
  </view>

  <view class="profile-mask" wx:if="{{showHistorySheet}}" catch:tap="closeHistorySheet">
    <view class="history-sheet" catch:tap="noop">
      <view class="profile-sheet-handle"></view>
      <view class="profile-sheet-title">全部历史心愿</view>
      <scroll-view class="history-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="history-card" wx:for="{{historyOrders}}" wx:key="id">
          <view class="latest-top">
            <view class="latest-date">{{item.dateText}}</view>
            <view class="latest-status">{{item.status}}</view>
          </view>
          <view class="latest-title">{{item.itemNames}}</view>
          <view class="latest-note" wx:if="{{item.note}}">“{{item.note}}”</view>
          <view class="latest-response" wx:if="{{item.responseText}}">{{item.responseText}}</view>
        </view>
      </scroll-view>
      <view class="history-close" bind:tap="closeHistorySheet">关闭</view>
    </view>
  </view>

  <view class="profile-mask" wx:if="{{showProfileEditor}}" catch:tap="closeProfileEditor">
    <view class="profile-sheet" catch:tap="noop">
      <view class="profile-sheet-handle"></view>
      <view class="profile-sheet-title">编辑我的资料</view>
      <button class="profile-avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="profile-avatar" wx:if="{{editAvatarUrl}}" src="{{editAvatarUrl}}" mode="aspectFill" />
        <view class="profile-avatar profile-avatar-empty" wx:else>＋</view>
      </button>
      <input
        class="profile-nickname-input"
        type="nickname"
        value="{{editNickname}}"
        maxlength="20"
        placeholder="输入你的昵称"
        bindinput="updateEditNickname"
      />
      <view class="profile-sheet-actions">
        <view class="profile-cancel" bind:tap="closeProfileEditor">取消</view>
        <view class="profile-save {{savingProfile ? 'profile-save-disabled' : ''}}" bind:tap="saveSelfProfile">
          {{savingProfile ? '保存中…' : '保存'}}
        </view>
      </view>
      <view class="profile-logout" bind:tap="logoutAccount">退出登录</view>
    </view>
  </view>
</view>
