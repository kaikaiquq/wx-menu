@import './styles/tokens.wxss';

page {
  background: #f4f4f1;
  color: #252b29;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

button, input, textarea {
  font-family: inherit;
}

button::after { border: 0; }

.letter-avatar {
  align-items: center;
  color: #ffffff;
  display: flex;
  font-family: var(--love-heading-font);
  font-weight: 600;
  justify-content: center;
  overflow: hidden;
}
