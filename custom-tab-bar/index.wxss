.theme-female {
  --love-primary: #bd6875;
}

.theme-male {
  --love-primary: #647e94;
}

.couple-tab-bar {
  --td-tab-bar-active-color: var(--love-primary, #bd6875);
  --td-tab-bar-bg-color: rgba(255, 255, 255, 0.97);
  --td-tab-bar-color: #a79d97;
  --td-tab-bar-height: 108rpx;
  box-shadow: 0 -12rpx 35rpx rgba(67, 52, 46, 0.07);
}

.custom-tab-bar-wrapper {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.tab-icon-wrap {
  align-items: center;
  display: flex;
  height: 45rpx;
  justify-content: center;
}

.custom-tab-bar-wrapper .text {
  font-size: 19rpx;
  letter-spacing: 1rpx;
}
