.theme-female {
  --love-primary: #bd6875;
}

.theme-male {
  --love-primary: #647e94;
}

.tab-bar {
  background: rgba(255, 255, 255, 0.97);
  bottom: 0;
  box-shadow: 0 -12rpx 35rpx rgba(67, 52, 46, 0.07);
  box-sizing: border-box;
  display: flex;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  right: 0;
  z-index: 999;
}

.tab-item {
  align-items: center;
  color: #a79d97;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  height: 108rpx;
  justify-content: center;
}

.tab-item-active {
  color: var(--love-primary, #bd6875);
}

.tab-icon-wrap {
  height: 42rpx;
  position: relative;
  width: 48rpx;
}

.tab-icon {
  font-size: 34rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
}

.tab-badge {
  background: #e54d42;
  border-radius: 18rpx;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 28rpx;
  min-width: 28rpx;
  padding: 0 8rpx;
  position: absolute;
  right: -18rpx;
  text-align: center;
  top: -8rpx;
}

.tab-text {
  font-size: 19rpx;
  letter-spacing: 1rpx;
}
